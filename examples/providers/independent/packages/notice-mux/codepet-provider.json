{
  "manifestVersion": 2,
  "pluginId": "independent.notice.mux",
  "displayName": "Independent Notice fixture",
  "icon": "https://nodejs.org/static/images/favicons/favicon.png",
  "command": "node",
  "args": [
    "provider.mjs"
  ],
  "env": {
    "ECHO_PLUGIN_ID": "independent.notice.mux",
    "ECHO_BACKEND": "notice"
