      "response": {
        "$ref": "messages.schema.json#/$defs/ConversationMarkReadResponse"
      },
      "description": "Advance this reader only up to the observed activity version, monotonically and durably. A newer activity remains unread. Preserve baseline/read progress; reject an invalid or future version as invalid_activity_version."
    },
