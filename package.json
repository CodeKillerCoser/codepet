{
  "name": "code-pet",
  "version": "0.3.9-beta",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "vite build",
    "build:bundle": "npm run protocol:check && npm run providers:stage && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "node scripts/tauri_with_native.mjs",
    "webrtc:build": "node tools/webrtc/build.mjs",
    "webrtc:check": "node tools/webrtc/build.mjs --check",
    "webrtc:test": "node --test tools/webrtc/build.test.mjs scripts/tauri_with_native.test.mjs",
    "providers:stage": "node scripts/stage_provider_plugins.mjs",
    "providers:stage:dev": "node scripts/stage_provider_plugins.mjs --profile debug",
    "providers:test": "node --test scripts/stage_provider_plugins.test.mjs",
    "package:signed": "python3 scripts/package_signed.py",
    "version:check": "node scripts/release_version.mjs",
    "version:sync": "node scripts/release_version.mjs --sync-version",
    "release:latest-json": "node scripts/generate_latest_json.mjs",
    "release:github": "node scripts/publish_github_release.mjs",
    "protocol:generate": "node tools/protocol-codegen/generate.mjs",
    "cp-sdk-gen": "bun tools/cp-sdk-gen/cp-sdk-gen.mjs",
    "protocol:test": "node --test tools/protocol-codegen/test.mjs",
    "protocol:check": "node tools/protocol-codegen/generate.mjs --check && node --test tools/protocol-codegen/test.mjs",
    "sdkgen:build": "bun build tools/cp-sdk-gen/cp-sdk-gen.mjs --compile --outfile tools/cp-sdk-gen/dist/cp-sdk-gen",
    "sdkgen:test": "bun test tools/cp-sdk-gen/cp-sdk-gen.test.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.16.0",
    "@radix-ui/colors": "^3.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
