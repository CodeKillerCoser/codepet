        "version": {
          "type": "string",
          "minLength": 1
        },
        "executablePath": {
          "type": "string",
          "minLength": 1
        },
        "authentication": {
          "$ref": "../../agent/v1/schema.json#/$defs/ProviderAuthentication"
        },
        "usage": {
          "$ref": "../../agent/v1/schema.json#/$defs/ProviderUsage"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "ProviderSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
