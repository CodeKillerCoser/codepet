      "type": "object",
      "properties": {
        "clientId": {
          "$ref": "../../core/v1/schema.json#/$defs/ClientId"
        },
        "device": {
          "$ref": "../../core/v1/schema.json#/$defs/DeviceDescriptor"
        },
        "clientVersion": {
          "type": "string",
          "minLength": 1
        },
        "supportedVersions": {
          "$ref": "../../core/v1/schema.json#/$defs/VersionRange"
        },
        "lastEventCursor": {
          "$ref": "../../core/v1/schema.json#/$defs/EventCursor"
        }
      },
      "required": [
        "clientId",
        "device",
        "clientVersion",
        "supportedVersions"
      ],
      "additionalProperties": false
    },
    "HandshakeResponse": {
      "type": "object",
      "properties": {
        "protocol": {
          "$ref": "#/$defs/GatewayProtocol"
        },
        "device": {
          "$ref": "#/$defs/GatewayDevice"
        },
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderSummary"
          }
        },
        "eventCursor": {
          "$ref": "../../core/v1/schema.json#/$defs/EventCursor"
        }
      },
      "required": [
        "protocol",
        "device",
        "providers",
        "eventCursor"
      ],
      "additionalProperties": false
    },
    "ProtocolFeature": {
      "type": "string",
      "enum": [
        "trace-context-v1"
      ]
    },
    "ProtocolDescribeRequest": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "ProtocolDescribeResponse": {
      "type": "object",
      "properties": {
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProtocolFeature"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "features"
      ],
      "additionalProperties": false
