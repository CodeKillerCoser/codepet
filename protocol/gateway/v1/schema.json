    "ConversationProjectFilter": {
      "oneOf": [
        {
          "$ref": "#/$defs/ConversationProjectFilterAll"
        },
        {
          "$ref": "#/$defs/ConversationProjectFilterStandalone"
        },
        {
          "$ref": "#/$defs/ConversationProjectFilterProject"
        }
      ]
    },
    "ConversationProjectFilterAll": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ConversationProjectFilterAllKind"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "ConversationProjectFilterAllKind": {
      "type": "string",
      "enum": [
        "all"
      ]
    },
    "ConversationProjectFilterStandalone": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ConversationProjectFilterStandaloneKind"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "ConversationProjectFilterStandaloneKind": {
      "type": "string",
      "enum": [
        "standalone"
      ]
