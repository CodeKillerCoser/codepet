      },
      "required": ["displayName"],
      "additionalProperties": false
    },
    "ProviderRuntime": {
      "type": "object",
      "properties": {
        "status": { "$ref": "#/$defs/ProviderStatus" },
        "version": { "type": "string", "minLength": 1 },
