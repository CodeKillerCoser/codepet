        "roots": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProjectRoot" }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "position": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Provider-defined ordering position. Read-only in Project v1 operations."
        },
        "createdAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "updatedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" }
      },
      "required": ["resource", "name", "roots", "metadata", "position", "createdAt", "updatedAt"],
      "additionalProperties": false
    },
    "ProjectChangeType": {
      "type": "string",
      "enum": ["created", "updated", "deleted"]
    },
    "ProjectChangedEvent": {
      "type": "object",
      "properties": {
        "project": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "changeType": { "$ref": "#/$defs/ProjectChangeType" }
      },
      "required": ["project", "changeType"],
      "additionalProperties": false
    },
    "ProjectCreateRequest": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/GatewayProviderRoute" },
