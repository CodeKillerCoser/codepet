      "type": "object",
      "properties": {
        "providerId": {
          "$ref": "../../agent/v1/schema.json#/$defs/ProviderId"
        },
        "searchTerm": {
          "type": "string",
          "minLength": 1
        },
        "cursor": {
          "$ref": "../../core/v1/schema.json#/$defs/Cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "providerId",
        "searchTerm"
      ],
      "additionalProperties": false
