        "revision": { "type": "string", "minLength": 1 }
      },
      "required": ["revision"],
      "additionalProperties": false
    },
    "ProviderIdentity": {
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
