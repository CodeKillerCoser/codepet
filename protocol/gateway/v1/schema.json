    "ConversationSearchResponse": {
      "type": "object",
      "properties": {
        "conversations": {
          "type": "array",
          "items": {
            "$ref": "../../agent/v1/schema.json#/$defs/Conversation"
          }
        },
        "pageInfo": {
          "$ref": "../../core/v1/schema.json#/$defs/PageInfo"
        },
        "snapshotCursor": {
          "$ref": "../../core/v1/schema.json#/$defs/EventCursor"
        }
      },
      "required": [
        "conversations",
        "pageInfo",
        "snapshotCursor"
      ],
      "additionalProperties": false
    },
    "ConversationUpsertedEvent": {
      "type": "object",
      "properties": {
        "conversation": {
          "$ref": "../../agent/v1/schema.json#/$defs/Conversation"
        }
      },
      "required": [
        "conversation"
      ],
      "additionalProperties": false
    },
    "ConversationItemUpsertedEvent": {
      "type": "object",
      "properties": {
        "item": {
          "$ref": "../../agent/v1/schema.json#/$defs/ConversationItem"
        }
      },
      "required": [
        "item"
      ],
      "additionalProperties": false
    },
    "ConversationActivityChangedEvent": {
      "type": "object",
      "properties": {
        "conversation": {
          "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId"
        },
        "activityVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "conversation",
        "activityVersion"
      ],
      "additionalProperties": false
