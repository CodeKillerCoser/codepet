      "type": "object",
      "properties": {
        "providerId": {
          "$ref": "../../agent/v1/schema.json#/$defs/ProviderId"
        },
        "projectFilter": {
          "$ref": "#/$defs/ConversationProjectFilter"
        },
        "cursor": {
          "$ref": "../../core/v1/schema.json#/$defs/Cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "providerId",
        "projectFilter"
      ],
      "additionalProperties": false
    },
    "ConversationListResponse": {
      "type": "object",
      "properties": {
        "conversations": {
          "type": "array",
          "items": {
            "$ref": "../../agent/v1/schema.json#/$defs/Conversation"
          }
        },
        "pageInfo": {
          "$ref": "../../core/v1/schema.json#/$defs/PageInfo"
        },
        "snapshotCursor": {
          "$ref": "../../core/v1/schema.json#/$defs/EventCursor"
        }
      },
      "required": [
        "conversations",
        "pageInfo",
        "snapshotCursor"
      ],
      "additionalProperties": false
