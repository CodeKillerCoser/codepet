      "type": "object",
      "properties": {
        "project": {
          "$ref": "../../agent/v1/schema.json#/$defs/Project"
        }
      },
      "required": [
        "project"
      ],
      "additionalProperties": false
    },
    "ProjectDeleteRequest": {
      "type": "object",
      "properties": {
        "project": {
          "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId"
        }
      },
      "required": [
        "project"
      ],
      "additionalProperties": false
    },
    "ProjectDeleteResponse": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "ProjectGetRequest": {
      "type": "object",
      "properties": {
        "project": {
          "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId"
        }
      },
      "required": [
        "project"
      ],
      "additionalProperties": false
    },
    "ProjectGetResponse": {
      "type": "object",
      "properties": {
        "project": {
          "$ref": "../../agent/v1/schema.json#/$defs/Project"
        }
      },
      "required": [
        "project"
      ],
      "additionalProperties": false
    },
    "ProjectListRequest": {
      "type": "object",
      "properties": {
        "providerId": {
          "$ref": "../../agent/v1/schema.json#/$defs/ProviderId"
        },
        "cursor": {
          "$ref": "../../core/v1/schema.json#/$defs/Cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "providerId"
      ],
      "additionalProperties": false
    },
    "ProjectListResponse": {
      "type": "object",
      "properties": {
        "projects": {
          "type": "array",
          "items": {
            "$ref": "../../agent/v1/schema.json#/$defs/Project"
          }
        },
        "pageInfo": {
          "$ref": "../../core/v1/schema.json#/$defs/PageInfo"
        },
        "snapshotCursor": {
          "$ref": "../../core/v1/schema.json#/$defs/EventCursor"
        }
      },
      "required": [
        "projects",
        "pageInfo",
        "snapshotCursor"
      ],
      "additionalProperties": false
    },
    "ProjectUpdateRequest": {
      "type": "object",
      "properties": {
        "project": {
          "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "roots": {
          "type": "array",
          "items": {
            "$ref": "../../agent/v1/schema.json#/$defs/ProjectRoot"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
