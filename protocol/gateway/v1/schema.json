        "identity": {
          "$ref": "#/$defs/ProviderIdentity"
        },
        "runtime": {
          "$ref": "#/$defs/ProviderRuntime"
        },
        "capabilities": {
          "$ref": "#/$defs/ProviderCapabilitiesSummary"
        }
      },
      "required": [
        "id",
        "identity",
        "runtime",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "ProviderDescribeRequest": {
      "type": "object",
      "properties": {
        "providerId": {
          "$ref": "../../agent/v1/schema.json#/$defs/ProviderId"
        }
      },
      "required": [
        "providerId"
      ],
      "additionalProperties": false
    },
    "ProviderDescribeResponse": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/ProviderSummary"
        },
        "capabilities": {
          "$ref": "#/$defs/GatewayCapabilities"
        }
      },
      "required": [
        "provider",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "ProviderListRequest": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "ProviderListResponse": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderSummary"
          }
        }
      },
      "required": [
        "providers"
      ],
      "additionalProperties": false
    },
