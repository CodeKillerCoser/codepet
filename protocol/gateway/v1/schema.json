    "ConversationCreateResponse": {
      "type": "object",
      "properties": {
        "conversation": {
          "$ref": "../../agent/v1/schema.json#/$defs/Conversation"
        }
      },
      "required": [
        "conversation"
      ],
      "additionalProperties": false
    },
