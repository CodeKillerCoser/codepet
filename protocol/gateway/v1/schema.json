    },
    "ProjectCreateResponse": {
      "type": "object",
      "properties": {
        "project": { "$ref": "#/$defs/Project" }
      },
      "required": ["project"],
      "additionalProperties": false
    },
    "ProjectDeleteRequest": {
      "type": "object",
      "properties": {
        "project": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" }
      },
      "required": ["project"],
      "additionalProperties": false
    },
    "ProjectDeleteResponse": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "ProjectGetRequest": {
      "type": "object",
      "properties": {
        "project": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" }
      },
      "required": ["project"],
      "additionalProperties": false
    },
    "ProjectGetResponse": {
      "type": "object",
      "properties": {
        "project": { "$ref": "#/$defs/Project" }
      },
      "required": ["project"],
      "additionalProperties": false
    },
    "ProjectListRequest": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/GatewayProviderRoute" },
        "cursor": { "$ref": "../../core/v1/schema.json#/$defs/Cursor" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "required": ["route"],
      "additionalProperties": false
    },
    "ProjectListResponse": {
      "type": "object",
      "properties": {
        "projects": {
          "type": "array",
          "items": { "$ref": "#/$defs/Project" }
        },
        "pageInfo": { "$ref": "../../core/v1/schema.json#/$defs/PageInfo" },
        "snapshotCursor": { "$ref": "../../core/v1/schema.json#/$defs/EventCursor" }
      },
      "required": ["projects", "pageInfo", "snapshotCursor"],
      "additionalProperties": false
    },
    "ProjectRoot": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1 }
      },
      "required": ["path"],
      "additionalProperties": false
    },
    "ProjectUpdateRequest": {
      "type": "object",
      "properties": {
        "project": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "name": { "type": "string", "minLength": 1 },
        "roots": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProjectRoot" }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "required": ["project"],
      "additionalProperties": false
    },
    "ProjectUpdateResponse": {
      "type": "object",
      "properties": {
        "project": { "$ref": "#/$defs/Project" }
      },
      "required": ["project"],
      "additionalProperties": false
    },
    "HandshakeRequest": {
      "type": "object",
      "properties": {
        "clientId": { "$ref": "../../core/v1/schema.json#/$defs/ClientId" },
        "device": { "$ref": "../../core/v1/schema.json#/$defs/DeviceDescriptor" },
        "clientVersion": { "type": "string", "minLength": 1 },
        "supportedVersions": { "$ref": "../../core/v1/schema.json#/$defs/VersionRange" },
        "lastEventCursor": { "$ref": "../../core/v1/schema.json#/$defs/EventCursor" }
