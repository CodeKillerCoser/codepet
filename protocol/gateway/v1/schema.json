      "type": "object",
      "properties": {
        "turn": {
          "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId"
        },
        "conversation": {
          "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId"
        },
        "itemId": {
          "$ref": "../../core/v1/schema.json#/$defs/NativeResourceId"
        },
        "contentId": {
          "$ref": "../../core/v1/schema.json#/$defs/NativeResourceId"
        },
        "kind": {
          "$ref": "../../agent/v1/schema.json#/$defs/ConversationContentKind"
        },
        "delta": {
          "type": "string"
