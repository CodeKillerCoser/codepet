        "decision": {
          "$ref": "../../agent/v1/schema.json#/$defs/ApprovalDecision"
        }
      },
      "required": [
        "approval",
        "decision"
      ],
      "additionalProperties": false
    },
    "ApprovalResolveResponse": {
      "type": "object",
      "properties": {
        "approval": {
          "$ref": "../../agent/v1/schema.json#/$defs/Approval"
        }
      },
      "required": [
        "approval"
      ],
      "additionalProperties": false
    },
    "ApprovalResolvedEvent": {
      "type": "object",
      "properties": {
        "approval": {
          "$ref": "../../agent/v1/schema.json#/$defs/Approval"
