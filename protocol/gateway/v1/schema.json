      "required": [
        "afterCursor"
      ],
      "additionalProperties": false
    },
    "EventSubscribeResponse": {
      "type": "object",
      "properties": {
        "subscribedAfterCursor": {
          "$ref": "../../core/v1/schema.json#/$defs/EventCursor"
