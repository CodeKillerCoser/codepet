      "type": "object",
      "properties": {
        "project": {
          "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId"
        },
        "changeType": {
          "$ref": "../../agent/v1/schema.json#/$defs/ProjectChangeType"
        }
      },
      "required": [
        "project",
        "changeType"
      ],
      "additionalProperties": false
    },
    "ProjectCreateRequest": {
      "type": "object",
      "properties": {
        "providerId": {
          "$ref": "../../agent/v1/schema.json#/$defs/ProviderId"
        },
        "idempotencyKey": {
          "$ref": "../../core/v1/schema.json#/$defs/RequestId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "roots": {
          "type": "array",
          "items": {
            "$ref": "../../agent/v1/schema.json#/$defs/ProjectRoot"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "providerId",
        "idempotencyKey",
        "name",
        "roots",
        "metadata"
      ],
      "additionalProperties": false
