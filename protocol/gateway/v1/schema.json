        "name": { "type": "string", "minLength": 1 },
        "roots": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProjectRoot" }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "required": ["route", "idempotencyKey", "name", "roots", "metadata"],
