    "HandshakeResponse": {
      "type": "object",
      "properties": {
        "protocol": { "$ref": "#/$defs/GatewayProtocol" },
        "device": { "$ref": "#/$defs/GatewayDevice" },
        "providers": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProviderSummary" }
        },
        "eventCursor": { "$ref": "../../core/v1/schema.json#/$defs/EventCursor" }
      },
      "required": ["protocol", "device", "providers", "eventCursor"],
      "additionalProperties": false
    },
    "GatewayDevice": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "operatingSystem": { "type": "string", "minLength": 1 },
        "systemVersion": { "type": "string", "minLength": 1 }
      },
      "required": ["name", "operatingSystem", "systemVersion"],
      "additionalProperties": false
    },
    "GatewayProtocol": {
      "type": "object",
      "properties": {
        "version": { "$ref": "../../core/v1/schema.json#/$defs/ProtocolVersion" }
      },
      "required": ["version"],
      "additionalProperties": false
    },
    "ProviderAuthenticationStatus": {
      "type": "string",
      "enum": ["unknown", "signed-in", "signed-out", "expired", "error", "unsupported"]
    },
    "ProviderAuthentication": {
      "type": "object",
      "properties": {
        "status": { "$ref": "#/$defs/ProviderAuthenticationStatus" },
