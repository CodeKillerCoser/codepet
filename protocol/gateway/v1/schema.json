      "type": "string",
      "enum": [
        "connecting",
        "ready",
        "stopped",
        "unavailable",
        "error"
      ]
    },
    "ProviderChangedEvent": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/ProviderSummary"
        }
      },
      "required": [
        "provider"
      ],
      "additionalProperties": false
    },
