{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-pet.dev/protocol/gateway/v1/schema.json",
  "title": "CodePet Gateway Protocol v1",
  "$defs": {
    "Approval": {
      "type": "object",
      "properties": {
        "resource": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "turn": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "kind": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "status": { "$ref": "#/$defs/ApprovalStatus" },
        "decisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/ApprovalDecision" },
          "minItems": 1,
          "uniqueItems": true
        },
        "requestedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "resolvedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "decision": { "$ref": "#/$defs/ApprovalDecision" }
      },
      "required": ["resource", "conversation", "turn", "kind", "title", "status", "decisions"],
      "additionalProperties": false
    },
    "ApprovalDecision": {
      "type": "string",
      "enum": ["approve", "deny"]
    },
    "ApprovalRequestedEvent": {
      "type": "object",
      "properties": {
        "approval": { "$ref": "#/$defs/Approval" }
      },
      "required": ["approval"],
      "additionalProperties": false
    },
    "ApprovalResolveRequest": {
      "type": "object",
      "properties": {
        "approval": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "decision": { "$ref": "#/$defs/ApprovalDecision" }
      },
      "required": ["approval", "decision"],
      "additionalProperties": false
    },
    "ApprovalResolveResponse": {
      "type": "object",
      "properties": {
        "approval": { "$ref": "#/$defs/Approval" }
      },
      "required": ["approval"],
      "additionalProperties": false
    },
    "ApprovalResolvedEvent": {
      "type": "object",
      "properties": {
        "approval": { "$ref": "#/$defs/Approval" }
      },
      "required": ["approval"],
      "additionalProperties": false
    },
    "ApprovalStatus": {
      "type": "string",
      "enum": ["pending", "approved", "denied", "expired"]
    },
    "Conversation": {
      "type": "object",
      "properties": {
        "resource": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "title": { "type": "string", "minLength": 1 },
        "preview": { "type": "string" },
        "status": { "$ref": "#/$defs/ConversationStatus" },
        "permissionLevel": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "reasoningEffort": { "type": "string" },
        "workspaceRoot": { "type": "string", "minLength": 1 },
        "createdAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "updatedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "activeTurn": { "$ref": "#/$defs/TurnTask" }
      },
      "required": ["resource", "title", "status"],
      "additionalProperties": false
    },
    "ConversationCreateRequest": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/GatewayProviderRoute" },
        "title": { "type": "string", "minLength": 1 },
        "permissionLevel": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "type": "string", "minLength": 1 },
        "workspaceRoot": { "type": "string", "minLength": 1 }
      },
      "required": ["route", "permissionLevel"],
      "additionalProperties": false
    },
    "ConversationCreateResponse": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "#/$defs/Conversation" }
      },
      "required": ["conversation"],
      "additionalProperties": false
    },
    "ConversationGetRequest": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" }
      },
      "required": ["conversation"],
      "additionalProperties": false
    },
    "ConversationGetResponse": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "#/$defs/Conversation" }
      },
      "required": ["conversation"],
      "additionalProperties": false
    },
    "ConversationListRequest": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/GatewayProviderRoute" },
        "cursor": { "$ref": "../../core/v1/schema.json#/$defs/Cursor" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "ConversationListResponse": {
      "type": "object",
      "properties": {
        "conversations": {
          "type": "array",
          "items": { "$ref": "#/$defs/Conversation" }
        },
        "pageInfo": { "$ref": "../../core/v1/schema.json#/$defs/PageInfo" },
        "eventCursor": { "$ref": "../../core/v1/schema.json#/$defs/EventCursor" }
      },
      "required": ["conversations", "pageInfo", "eventCursor"],
      "additionalProperties": false
    },
    "ConversationStatus": {
      "type": "string",
      "enum": ["idle", "running", "waiting-approval", "waiting-user-input", "error", "archived"]
    },
    "ConversationUpsertedEvent": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "#/$defs/Conversation" }
      },
      "required": ["conversation"],
      "additionalProperties": false
    },
    "Device": {
      "type": "object",
      "properties": {
        "deviceId": { "$ref": "../../core/v1/schema.json#/$defs/DeviceId" },
        "displayName": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/DeviceStatus" },
        "lastSeenAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" }
      },
      "required": ["deviceId", "displayName", "status"],
      "additionalProperties": false
    },
    "DeviceListRequest": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "DeviceListResponse": {
      "type": "object",
      "properties": {
        "devices": {
          "type": "array",
          "items": { "$ref": "#/$defs/Device" }
        }
      },
      "required": ["devices"],
      "additionalProperties": false
    },
    "DeviceStatus": {
      "type": "string",
      "enum": ["online", "offline"]
    },
    "DeviceStatusChangedEvent": {
      "type": "object",
      "properties": {
        "device": { "$ref": "#/$defs/Device" },
        "previousStatus": { "$ref": "#/$defs/DeviceStatus" }
      },
      "required": ["device"],
      "additionalProperties": false
    },
    "GatewayCapability": {
      "type": "string",
      "enum": [
        "conversation.list",
        "conversation.get",
        "conversation.create",
        "turn.send",
        "turn.interrupt",
        "approval.resolve"
      ]
    },
    "GatewayCapabilities": {
      "type": "object",
      "properties": {
        "methods": {
          "type": "array",
          "items": { "$ref": "#/$defs/GatewayCapability" },
          "uniqueItems": true
        },
        "permissionLevels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "models": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "reasoningEfforts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "required": ["methods", "permissionLevels", "models", "reasoningEfforts"],
      "additionalProperties": false
    },
    "GatewayProviderRoute": {
      "type": "object",
      "properties": {
        "deviceId": { "$ref": "../../core/v1/schema.json#/$defs/DeviceId" },
        "providerPluginId": { "$ref": "../../core/v1/schema.json#/$defs/ProviderPluginId" },
        "providerInstanceId": { "$ref": "../../core/v1/schema.json#/$defs/ProviderInstanceId" }
      },
      "required": ["deviceId", "providerPluginId", "providerInstanceId"],
      "additionalProperties": false
    },
    "HandshakeRequest": {
      "type": "object",
      "properties": {
        "clientId": { "$ref": "../../core/v1/schema.json#/$defs/ClientId" },
        "clientName": { "type": "string", "minLength": 1 },
        "clientVersion": { "type": "string", "minLength": 1 },
        "supportedVersions": { "$ref": "../../core/v1/schema.json#/$defs/VersionRange" },
        "lastEventCursor": { "$ref": "../../core/v1/schema.json#/$defs/EventCursor" }
      },
      "required": ["clientId", "clientName", "clientVersion", "supportedVersions"],
      "additionalProperties": false
    },
    "HandshakeResponse": {
      "type": "object",
      "properties": {
        "selectedVersion": { "$ref": "../../core/v1/schema.json#/$defs/ProtocolVersion" },
        "serverName": { "type": "string", "minLength": 1 },
        "serverVersion": { "type": "string", "minLength": 1 },
        "devices": {
          "type": "array",
          "items": { "$ref": "#/$defs/Device" }
        },
        "providers": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProviderInstance" }
        },
        "eventCursor": { "$ref": "../../core/v1/schema.json#/$defs/EventCursor" }
      },
      "required": ["selectedVersion", "serverName", "serverVersion", "devices", "providers", "eventCursor"],
      "additionalProperties": false
    },
    "ProviderInstance": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/GatewayProviderRoute" },
        "pluginId": { "$ref": "../../core/v1/schema.json#/$defs/ProviderPluginId" },
        "displayName": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "status": { "$ref": "#/$defs/ProviderStatus" },
        "capabilities": { "$ref": "#/$defs/GatewayCapabilities" }
      },
      "required": ["route", "pluginId", "displayName", "status", "capabilities"],
      "additionalProperties": false
    },
    "ProviderListRequest": {
      "type": "object",
      "properties": {
        "deviceId": { "$ref": "../../core/v1/schema.json#/$defs/DeviceId" }
      },
      "additionalProperties": false
    },
    "ProviderListResponse": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProviderInstance" }
        }
      },
      "required": ["providers"],
      "additionalProperties": false
    },
    "ProviderStatus": {
      "type": "string",
      "enum": ["disconnected", "connecting", "ready", "unavailable", "error"]
    },
    "ProviderStatusChangedEvent": {
      "type": "object",
      "properties": {
        "provider": { "$ref": "#/$defs/ProviderInstance" },
        "previousStatus": { "$ref": "#/$defs/ProviderStatus" }
      },
      "required": ["provider"],
      "additionalProperties": false
    },
    "TurnInterruptRequest": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "turn": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" }
      },
      "required": ["conversation", "turn"],
      "additionalProperties": false
    },
    "TurnInterruptResponse": {
      "type": "object",
      "properties": {
        "turn": { "$ref": "#/$defs/TurnTask" }
      },
      "required": ["turn"],
      "additionalProperties": false
    },
    "TurnOutputDeltaEvent": {
      "type": "object",
      "properties": {
        "turn": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "outputId": { "$ref": "../../core/v1/schema.json#/$defs/NativeResourceId" },
        "kind": { "type": "string", "minLength": 1 },
        "delta": { "type": "string" }
      },
      "required": ["turn", "conversation", "outputId", "kind", "delta"],
      "additionalProperties": false
    },
    "TurnSendRequest": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "clientMessageId": { "$ref": "../../core/v1/schema.json#/$defs/RequestId" },
        "message": { "type": "string", "minLength": 1 },
        "steerTurn": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" }
      },
      "required": ["conversation", "clientMessageId", "message"],
      "additionalProperties": false
    },
    "TurnSendResponse": {
      "type": "object",
      "properties": {
        "turn": { "$ref": "#/$defs/TurnTask" }
      },
      "required": ["turn"],
      "additionalProperties": false
    },
    "TurnStatus": {
      "type": "string",
      "enum": ["queued", "running", "waiting-approval", "completed", "failed", "interrupted"]
    },
    "TurnTask": {
      "type": "object",
      "properties": {
        "resource": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "status": { "$ref": "#/$defs/TurnStatus" },
        "displaySummary": { "type": "string" },
        "startedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "updatedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "completedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" }
      },
      "required": ["resource", "conversation", "status"],
      "additionalProperties": false
    },
    "TurnUpsertedEvent": {
      "type": "object",
      "properties": {
        "turn": { "$ref": "#/$defs/TurnTask" }
      },
      "required": ["turn"],
      "additionalProperties": false
    }
  }
}
