        "authentication": { "$ref": "#/$defs/ProviderAuthentication" },
        "usage": { "$ref": "#/$defs/ProviderUsage" }
      },
      "required": ["status"],
      "additionalProperties": false
    },
    "ProviderSummary": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "identity": { "$ref": "#/$defs/ProviderIdentity" },
        "runtime": { "$ref": "#/$defs/ProviderRuntime" },
        "capabilities": { "$ref": "#/$defs/ProviderCapabilitiesSummary" }
      },
      "required": ["id", "identity", "runtime", "capabilities"],
      "additionalProperties": false
    },
    "ProviderUsage": {
      "type": "object",
      "properties": {
        "displayText": { "type": "string", "minLength": 1 },
        "observedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "details": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProviderUsageDetail" }
        }
      },
      "required": ["displayText"],
      "additionalProperties": false
    },
    "ProviderUsageDetail": {
      "type": "object",
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "string", "minLength": 1 },
        "data": { "$ref": "../../core/v1/schema.json#/$defs/JsonObject" }
      },
      "required": ["namespace", "schemaVersion", "data"],
      "additionalProperties": false
    },
    "ProviderDescribeRequest": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "ProviderDescribeResponse": {
      "type": "object",
      "properties": {
        "providerId": { "type": "string", "minLength": 1 },
        "capabilities": { "$ref": "#/$defs/GatewayCapabilities" }
      },
      "required": ["providerId", "capabilities"],
      "additionalProperties": false
    },
    "ProviderListRequest": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "ProviderListResponse": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProviderSummary" }
        }
      },
      "required": ["providers"],
      "additionalProperties": false
    },
    "ProviderStatus": {
      "type": "string",
      "enum": ["connecting", "ready", "stopped", "unavailable", "error"]
    },
    "ProviderChangedEvent": {
      "type": "object",
      "properties": {
        "provider": { "$ref": "#/$defs/ProviderSummary" }
      },
      "required": ["provider"],
      "additionalProperties": false
    },
    "TurnInterruptRequest": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "turn": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" }
      },
      "required": ["conversation", "turn"],
      "additionalProperties": false
    },
    "TurnInterruptResponse": {
      "type": "object",
      "properties": {
        "turn": { "$ref": "#/$defs/TurnTask" }
      },
      "required": ["turn"],
      "additionalProperties": false
    },
    "TurnOutputDeltaEvent": {
      "type": "object",
      "properties": {
        "turn": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "itemId": { "$ref": "../../core/v1/schema.json#/$defs/NativeResourceId" },
        "contentId": { "$ref": "../../core/v1/schema.json#/$defs/NativeResourceId" },
        "kind": { "$ref": "#/$defs/ConversationContentKind" },
        "delta": { "type": "string" }
      },
      "required": ["turn", "conversation", "itemId", "contentId", "kind", "delta"],
      "additionalProperties": false
    },
    "TurnSendRequest": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "clientRequestId": { "$ref": "../../core/v1/schema.json#/$defs/RequestId" },
        "capabilityRevision": { "type": "string", "minLength": 1 },
        "input": { "$ref": "#/$defs/TurnInput" },
        "selection": { "$ref": "#/$defs/TurnSelection" }
      },
      "required": ["conversation", "clientRequestId", "capabilityRevision", "input", "selection"],
      "additionalProperties": false
    },
    "TurnSendResponse": {
      "type": "object",
      "properties": {
        "accepted": { "type": "boolean" },
        "turn": { "$ref": "#/$defs/TurnTask" },
        "userItem": {
          "oneOf": [
            { "$ref": "#/$defs/ConversationItem" },
            { "type": "null" }
          ]
        },
        "effectiveSelection": { "$ref": "#/$defs/TurnSelection" }
      },
      "required": ["accepted", "turn", "userItem", "effectiveSelection"],
      "additionalProperties": false
    },
    "TurnStatus": {
      "type": "string",
      "enum": ["queued", "running", "waiting-approval", "completed", "failed", "interrupted"]
    },
    "TurnTask": {
      "type": "object",
      "properties": {
        "resource": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "status": { "$ref": "#/$defs/TurnStatus" },
        "displaySummary": { "type": "string" },
        "startedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "updatedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "completedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" }
      },
      "required": ["resource", "conversation", "status"],
      "additionalProperties": false
    },
    "TurnUpsertedEvent": {
      "type": "object",
      "properties": {
        "turn": { "$ref": "#/$defs/TurnTask" }
      },
      "required": ["turn"],
      "additionalProperties": false
    }
  }
}
