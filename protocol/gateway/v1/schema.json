      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "operatingSystem": {
          "type": "string",
          "minLength": 1
        },
        "systemVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "operatingSystem",
        "systemVersion"
      ],
      "additionalProperties": false
    },
    "GatewayProtocol": {
      "type": "object",
      "properties": {
        "version": {
          "$ref": "../../core/v1/schema.json#/$defs/ProtocolVersion"
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    },
    "ProviderCapabilitiesSummary": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "revision"
      ],
      "additionalProperties": false
    },
    "ProviderIdentity": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1
        },
