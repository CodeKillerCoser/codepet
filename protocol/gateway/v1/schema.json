{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-pet.dev/protocol/gateway/v1/schema.json",
  "title": "CodePet Gateway Protocol v1",
  "$defs": {
    "Approval": {
      "type": "object",
      "properties": {
        "resource": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "turn": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "kind": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "status": { "$ref": "#/$defs/ApprovalStatus" },
        "decisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/ApprovalDecision" },
          "minItems": 1,
          "uniqueItems": true
        },
        "requestedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "resolvedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "decision": { "$ref": "#/$defs/ApprovalDecision" }
      },
      "required": ["resource", "conversation", "turn", "kind", "title", "status", "decisions"],
      "additionalProperties": false
    },
    "ApprovalDecision": {
      "type": "string",
      "enum": ["approve", "deny"]
    },
    "ApprovalRequestedEvent": {
      "type": "object",
      "properties": {
        "approval": { "$ref": "#/$defs/Approval" }
      },
      "required": ["approval"],
      "additionalProperties": false
    },
    "ApprovalResolveRequest": {
      "type": "object",
      "properties": {
        "approval": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "decision": { "$ref": "#/$defs/ApprovalDecision" }
      },
      "required": ["approval", "decision"],
      "additionalProperties": false
    },
    "ApprovalResolveResponse": {
      "type": "object",
      "properties": {
        "approval": { "$ref": "#/$defs/Approval" }
      },
      "required": ["approval"],
      "additionalProperties": false
    },
    "ApprovalResolvedEvent": {
      "type": "object",
      "properties": {
        "approval": { "$ref": "#/$defs/Approval" }
      },
      "required": ["approval"],
      "additionalProperties": false
    },
    "ApprovalStatus": {
      "type": "string",
      "enum": ["pending", "approved", "denied", "expired"]
    },
    "Conversation": {
      "type": "object",
      "properties": {
        "resource": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "project": {
          "oneOf": [
            { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
            { "type": "null" }
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "preview": { "type": "string" },
        "status": { "$ref": "#/$defs/ConversationStatus" },
        "permissionLevel": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "reasoningEffort": { "type": "string" },
        "selection": { "$ref": "#/$defs/TurnSelection" },
        "workspaceRoot": { "type": "string", "minLength": 1 },
        "createdAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "updatedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "activeTurn": { "$ref": "#/$defs/TurnTask" },
        "readState": { "$ref": "#/$defs/ConversationReadState" }
      },
      "required": ["resource", "project", "title", "status"],
      "additionalProperties": false
    },
    "ConversationAcquireInteractionRequest": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" }
      },
      "required": ["conversation"],
      "additionalProperties": false
    },
    "ConversationAcquireInteractionResponse": {
      "type": "object",
      "properties": {
        "selection": { "$ref": "#/$defs/TurnSelection" },
        "leaseExpiresAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" }
      },
      "required": ["selection"],
      "additionalProperties": false
    },
    "ConversationCreateRequest": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/GatewayProviderRoute" },
        "title": { "type": "string", "minLength": 1 },
        "permissionLevel": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "type": "string", "minLength": 1 },
        "workspaceRoot": { "type": "string", "minLength": 1 },
        "workspaceMode": { "type": "string", "minLength": 1 },
        "project": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" }
      },
      "required": ["route", "permissionLevel"],
      "additionalProperties": false
    },
    "ConversationCreateResponse": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "#/$defs/Conversation" }
      },
      "required": ["conversation"],
      "additionalProperties": false
    },
    "ConversationGetRequest": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "cursor": { "$ref": "../../core/v1/schema.json#/$defs/Cursor" },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum number of native conversation turns to include in this history page."
        }
      },
      "required": ["conversation"],
      "additionalProperties": false
    },
    "ConversationGetResponse": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "#/$defs/Conversation" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/ConversationItem" }
        },
        "pageInfo": { "$ref": "../../core/v1/schema.json#/$defs/PageInfo" },
        "snapshotCursor": { "$ref": "../../core/v1/schema.json#/$defs/EventCursor" }
      },
      "required": ["conversation", "items", "snapshotCursor"],
      "additionalProperties": false
    },
    "ConversationContent": {
      "type": "object",
      "properties": {
        "contentId": { "$ref": "../../core/v1/schema.json#/$defs/NativeResourceId" },
        "kind": { "$ref": "#/$defs/ConversationContentKind" },
        "text": { "type": "string" }
      },
      "required": ["contentId", "kind", "text"],
      "additionalProperties": false
    },
    "ConversationContentKind": {
      "type": "string",
      "enum": ["text", "reasoning-summary", "command", "output", "activity-summary"]
    },
    "ToolAnnotations": {
      "type": "object",
      "properties": {
        "readOnly": { "type": "boolean" },
        "destructive": { "type": "boolean" },
        "idempotent": { "type": "boolean" },
        "openWorld": { "type": "boolean" }
      },
      "additionalProperties": false,
      "description": "Advisory UI hints only; clients must not use these fields as authorization decisions."
    },
    "ToolCategory": {
      "type": "string",
      "enum": ["command", "read", "write", "search", "web", "agent", "computer", "media", "other"]
    },
    "ToolCommandAction": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/ToolCommandActionKind" },
        "command": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "query": { "type": "string" }
      },
      "required": ["kind", "command"],
      "additionalProperties": false
    },
    "ToolCommandActionKind": {
      "type": "string",
      "enum": ["execute", "read", "list", "search", "unknown"]
    },
    "ToolCommandDetails": {
      "type": "object",
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string", "minLength": 1 },
        "exitCode": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "processId": { "type": "string", "minLength": 1 },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/ToolCommandAction" }
        }
      },
      "required": ["command"],
      "additionalProperties": false
    },
    "ToolContent": {
      "type": "object",
      "properties": {
        "contentId": { "$ref": "../../core/v1/schema.json#/$defs/NativeResourceId" },
        "kind": { "$ref": "#/$defs/ToolContentKind" },
        "text": { "type": "string" },
        "uri": { "type": "string", "minLength": 1 },
        "mimeType": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "truncated": { "type": "boolean" },
        "totalBytes": { "type": "integer", "minimum": 0 }
      },
      "required": ["contentId", "kind"],
      "additionalProperties": false,
      "description": "Tool result content discriminated by kind; clients validate kind-specific optional fields."
    },
    "ToolContentKind": {
      "type": "string",
      "enum": ["text", "image", "audio", "resource-link", "embedded-resource"]
    },
    "ToolExecutionError": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": { "$ref": "../../core/v1/schema.json#/$defs/JsonObject" }
      },
      "required": ["message"],
      "additionalProperties": false
    },
    "ToolInvocation": {
      "type": "object",
      "properties": {
        "callId": { "$ref": "../../core/v1/schema.json#/$defs/NativeResourceId" },
        "name": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/ToolCategory" },
        "origin": { "$ref": "#/$defs/ToolOrigin" },
        "input": { "$ref": "../../core/v1/schema.json#/$defs/JsonObject" },
        "rawInput": { "type": "string" },
        "result": { "$ref": "#/$defs/ToolResult" },
        "timing": { "$ref": "#/$defs/ToolTiming" },
        "command": { "$ref": "#/$defs/ToolCommandDetails" },
        "annotations": { "$ref": "#/$defs/ToolAnnotations" }
      },
      "required": ["callId", "name", "category", "origin", "input"],
      "additionalProperties": false,
      "description": "Provider-neutral client-safe tool-call envelope. Lifecycle remains ConversationItem.status."
    },
    "ToolOrigin": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/ToolOriginKind" },
        "name": { "type": "string", "minLength": 1 }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "ToolOriginKind": {
      "type": "string",
      "enum": ["builtin", "mcp", "plugin", "server", "custom", "unknown"]
    },
    "ToolResult": {
      "type": "object",
      "properties": {
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/ToolContent" }
        },
        "structuredContent": { "$ref": "../../core/v1/schema.json#/$defs/JsonObject" },
        "error": { "$ref": "#/$defs/ToolExecutionError" }
      },
      "required": ["content"],
      "additionalProperties": false
    },
    "ToolTiming": {
      "type": "object",
      "properties": {
        "startedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "completedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "durationMs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "ConversationItem": {
      "type": "object",
      "properties": {
        "resource": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "turn": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "kind": { "$ref": "#/$defs/ConversationItemKind" },
        "status": { "$ref": "#/$defs/ConversationItemStatus" },
        "role": { "$ref": "#/$defs/ConversationItemRole" },
        "title": { "type": "string", "minLength": 1 },
        "contents": {
          "type": "array",
          "items": { "$ref": "#/$defs/ConversationContent" }
        },
        "relatedItem": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "approval": { "$ref": "#/$defs/Approval" },
        "tool": { "$ref": "#/$defs/ToolInvocation" }
      },
      "required": ["resource", "turn", "conversation", "kind", "status", "contents"],
      "additionalProperties": false
    },
    "ConversationItemKind": {
      "type": "string",
      "enum": ["message", "reasoning", "command", "file-change", "tool", "approval", "unknown"]
    },
    "ConversationItemRole": {
      "type": "string",
      "enum": ["user", "assistant"]
    },
    "ConversationItemStatus": {
      "type": "string",
      "enum": ["pending", "running", "completed", "failed", "interrupted", "declined", "approved", "denied", "expired", "unknown"]
    },
    "ConversationListRequest": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/GatewayProviderRoute" },
        "projectFilter": { "$ref": "#/$defs/ConversationProjectFilter" },
        "cursor": { "$ref": "../../core/v1/schema.json#/$defs/Cursor" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "required": ["projectFilter"],
      "additionalProperties": false
    },
    "ConversationListResponse": {
      "type": "object",
      "properties": {
        "conversations": {
          "type": "array",
          "items": { "$ref": "#/$defs/Conversation" }
        },
        "pageInfo": { "$ref": "../../core/v1/schema.json#/$defs/PageInfo" },
        "snapshotCursor": { "$ref": "../../core/v1/schema.json#/$defs/EventCursor" }
      },
      "required": ["conversations", "pageInfo", "snapshotCursor"],
      "additionalProperties": false
    },
    "ConversationProjectFilter": {
      "oneOf": [
        { "$ref": "#/$defs/ConversationProjectFilterAll" },
        { "$ref": "#/$defs/ConversationProjectFilterStandalone" },
        { "$ref": "#/$defs/ConversationProjectFilterProject" }
      ]
    },
    "ConversationProjectFilterAll": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/ConversationProjectFilterAllKind" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "ConversationProjectFilterAllKind": {
      "type": "string",
      "enum": ["all"]
    },
    "ConversationProjectFilterStandalone": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/ConversationProjectFilterStandaloneKind" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "ConversationProjectFilterStandaloneKind": {
      "type": "string",
      "enum": ["standalone"]
    },
    "ConversationProjectFilterProject": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/ConversationProjectFilterProjectKind" },
        "project": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" }
      },
      "required": ["kind", "project"],
      "additionalProperties": false
    },
    "ConversationProjectFilterProjectKind": {
      "type": "string",
      "enum": ["project"]
    },
    "ConversationMarkReadRequest": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "observedActivityVersion": { "type": "string", "minLength": 1 }
      },
      "required": ["conversation", "observedActivityVersion"],
      "additionalProperties": false
    },
    "ConversationMarkReadResponse": {
      "type": "object",
      "properties": {
        "readState": { "$ref": "#/$defs/ConversationReadState" }
      },
      "required": ["readState"],
      "additionalProperties": false
    },
    "ConversationReadState": {
      "type": "object",
      "properties": {
        "unread": { "type": "boolean" },
        "activityVersion": { "type": "string", "minLength": 1 }
      },
      "required": ["unread", "activityVersion"],
      "additionalProperties": false
    },
    "ConversationSearchRequest": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/GatewayProviderRoute" },
        "searchTerm": { "type": "string", "minLength": 1 },
        "cursor": { "$ref": "../../core/v1/schema.json#/$defs/Cursor" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "required": ["route", "searchTerm"],
      "additionalProperties": false
    },
    "ConversationSearchResponse": {
      "type": "object",
      "properties": {
        "conversations": {
          "type": "array",
          "items": { "$ref": "#/$defs/Conversation" }
        },
        "pageInfo": { "$ref": "../../core/v1/schema.json#/$defs/PageInfo" },
        "snapshotCursor": { "$ref": "../../core/v1/schema.json#/$defs/EventCursor" }
      },
      "required": ["conversations", "pageInfo", "snapshotCursor"],
      "additionalProperties": false
    },
    "ConversationStatus": {
      "type": "string",
      "enum": ["idle", "running", "waiting-approval", "waiting-user-input", "error", "archived"]
    },
    "ConversationUpsertedEvent": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "#/$defs/Conversation" }
      },
      "required": ["conversation"],
      "additionalProperties": false
    },
    "ConversationItemUpsertedEvent": {
      "type": "object",
      "properties": {
        "item": { "$ref": "#/$defs/ConversationItem" }
      },
      "required": ["item"],
      "additionalProperties": false
    },
    "ConversationActivityChangedEvent": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "activityVersion": { "type": "string", "minLength": 1 }
      },
      "required": ["conversation", "activityVersion"],
      "additionalProperties": false
    },
    "ChoiceOption": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "enabled": { "type": "boolean" },
        "disabledReason": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "displayName"],
      "additionalProperties": false
    },
    "ChoiceSet": {
      "type": "object",
      "properties": {
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/ChoiceOption" },
          "minItems": 1
        },
        "defaultId": { "type": "string", "minLength": 1 }
      },
      "required": ["options"],
      "additionalProperties": false
    },
    "FlatModelCatalogKind": {
      "type": "string",
      "enum": ["flat"]
    },
    "FlatModelSelection": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/FlatModelCatalogKind" },
        "modelId": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "modelId"],
      "additionalProperties": false
    },
    "FlatModelCatalog": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/FlatModelCatalogKind" },
        "models": {
          "type": "array",
          "items": { "$ref": "#/$defs/ChoiceOption" },
          "minItems": 1
        },
        "defaultSelection": { "$ref": "#/$defs/FlatModelSelection" }
      },
      "required": ["kind", "models"],
      "additionalProperties": false
    },
    "GroupedModelCatalogKind": {
      "type": "string",
      "enum": ["grouped"]
    },
    "GroupedModelProvider": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "models": {
          "type": "array",
          "items": { "$ref": "#/$defs/ChoiceOption" },
          "minItems": 1
        }
      },
      "required": ["id", "displayName", "models"],
      "additionalProperties": false
    },
    "GroupedModelSelection": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/GroupedModelCatalogKind" },
        "providerId": { "type": "string", "minLength": 1 },
        "modelId": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "providerId", "modelId"],
      "additionalProperties": false
    },
    "GroupedModelCatalog": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/GroupedModelCatalogKind" },
        "providers": {
          "type": "array",
          "items": { "$ref": "#/$defs/GroupedModelProvider" },
          "minItems": 1
        },
        "defaultSelection": { "$ref": "#/$defs/GroupedModelSelection" }
      },
      "required": ["kind", "providers"],
      "additionalProperties": false
    },
    "ModelCatalog": {
      "oneOf": [
        { "$ref": "#/$defs/FlatModelCatalog" },
        { "$ref": "#/$defs/GroupedModelCatalog" }
      ]
    },
    "ModelSelection": {
      "oneOf": [
        { "$ref": "#/$defs/FlatModelSelection" },
        { "$ref": "#/$defs/GroupedModelSelection" }
      ]
    },
    "TurnSendCapabilities": {
      "type": "object",
      "properties": {
        "accessMode": { "$ref": "#/$defs/ChoiceSet" },
        "reasoningEffort": { "$ref": "#/$defs/ChoiceSet" },
        "modelCatalog": { "$ref": "#/$defs/ModelCatalog" }
      },
      "additionalProperties": false
    },
    "ConversationCreateCapabilities": {
      "type": "object",
      "properties": {
        "supportsTitle": { "type": "boolean" },
        "selection": { "$ref": "#/$defs/TurnSendCapabilities" },
        "workspaceMode": { "$ref": "#/$defs/ChoiceSet" }
      },
      "required": ["supportsTitle"],
      "additionalProperties": false
    },
    "TurnInputKind": {
      "type": "string",
      "enum": ["text"]
    },
    "TurnInput": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/TurnInputKind" },
        "text": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "text"],
      "additionalProperties": false
    },
    "TurnSelection": {
      "type": "object",
      "properties": {
        "accessModeId": { "type": "string", "minLength": 1 },
        "reasoningEffortId": { "type": "string", "minLength": 1 },
        "model": { "$ref": "#/$defs/ModelSelection" }
      },
      "additionalProperties": false
    },
    "EventSubscribeRequest": {
      "type": "object",
      "properties": {
        "afterCursor": { "$ref": "../../core/v1/schema.json#/$defs/EventCursor" }
      },
      "required": ["afterCursor"],
      "additionalProperties": false
    },
    "EventSubscribeResponse": {
      "type": "object",
      "properties": {
        "subscribedAfterCursor": { "$ref": "../../core/v1/schema.json#/$defs/EventCursor" }
      },
      "required": ["subscribedAfterCursor"],
      "additionalProperties": false
    },
    "GatewayCapability": {
      "type": "string",
      "enum": [
        "project.list",
        "project.get",
        "project.create",
        "project.update",
        "project.delete",
        "conversation.list",
        "conversation.search",
        "conversation.get",
        "conversation.create",
        "turn.send",
        "turn.interrupt",
        "approval.resolve"
      ]
    },
    "GatewayCapabilities": {
      "type": "object",
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "methods": {
          "type": "array",
          "items": { "$ref": "#/$defs/GatewayCapability" },
          "uniqueItems": true
        },
        "turnSend": { "$ref": "#/$defs/TurnSendCapabilities" },
        "conversationCreate": { "$ref": "#/$defs/ConversationCreateCapabilities" }
      },
      "required": ["revision", "methods"],
      "additionalProperties": false
    },
    "GatewayProviderRoute": {
      "type": "object",
      "properties": {
        "deviceId": { "$ref": "../../core/v1/schema.json#/$defs/DeviceId" },
        "providerPluginId": { "$ref": "../../core/v1/schema.json#/$defs/ProviderPluginId" },
        "providerInstanceId": { "$ref": "../../core/v1/schema.json#/$defs/ProviderInstanceId" }
      },
      "required": ["deviceId", "providerPluginId", "providerInstanceId"],
      "additionalProperties": false
    },
    "Project": {
      "type": "object",
      "properties": {
        "resource": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
