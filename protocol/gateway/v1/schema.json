    "ConversationProjectFilterProjectKind": {
      "type": "string",
      "enum": [
        "project"
      ]
    },
    "ConversationMarkReadRequest": {
      "type": "object",
      "properties": {
        "conversation": {
          "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId"
