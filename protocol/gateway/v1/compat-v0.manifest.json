      "response": { "$ref": "./compat-v0.schema.json#/$defs/ConversationGetResponse" }
    },
    {
      "name": "conversation.create",
      "direction": "clientToGateway",
      "idempotency": "nonIdempotent",
      "request": { "$ref": "./compat-v0.schema.json#/$defs/ConversationCreateRequest" },
      "response": { "$ref": "./compat-v0.schema.json#/$defs/ConversationCreateResponse" }
    },
    {
      "name": "turn.send",
      "direction": "clientToGateway",
