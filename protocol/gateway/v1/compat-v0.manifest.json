    {
      "name": "turn.interrupt",
      "direction": "clientToGateway",
      "idempotency": "idempotent",
      "request": { "$ref": "./compat-v0.schema.json#/$defs/TurnInterruptRequest" },
      "response": { "$ref": "./compat-v0.schema.json#/$defs/TurnInterruptResponse" }
    },
    {
      "name": "approval.resolve",
      "direction": "clientToGateway",
      "idempotency": "idempotent",
      "request": { "$ref": "./compat-v0.schema.json#/$defs/ApprovalResolveRequest" },
      "response": { "$ref": "./compat-v0.schema.json#/$defs/ApprovalResolveResponse" }
