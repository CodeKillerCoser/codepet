        },
        "maxDecodedMessageBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 134217728,
          "description": "解压后 UTF-8 JSON 的最大字节数。"
        },
        "receiveBudgetBytes": {
          "type": "integer",
          "minimum": 2048,
          "maximum": 1073741824,
          "description": "normal 通道接收对象及编码/解码缓冲区的字节预算。"
        },
        "normalStreams": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
