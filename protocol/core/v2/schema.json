        },
        "smallStreams": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "description": "small 通道并发消息槽位上限。"
        },
        "controlStreams": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "control 通道并发消息槽位上限。"
        },
        "smallMessageBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65536,
          "description": "small 通道单条消息的编码和解码尺寸上限。"
        },
        "smallReceiveBudgetBytes": {
          "type": "integer",
          "minimum": 2048,
          "maximum": 16777216,
          "description": "small 通道独立接收字节预算。"
        },
        "controlMessageBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16384,
          "description": "control 通道单条消息的编码和解码尺寸上限。"
        },
        "controlReceiveBudgetBytes": {
          "type": "integer",
          "minimum": 2048,
          "maximum": 1048576,
          "description": "control 通道独立接收字节预算。"
        },
        "connectionWindowBytes": {
          "type": "integer",
          "minimum": 33554432,
          "maximum": 268435456,
          "description": "Yamux 连接接收窗口的字节预算。"
        },
        "idleTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 120000,
          "description": "传输或准入过程无进展的超时时间，毫秒。"
