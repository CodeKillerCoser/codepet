        "streamTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000,
          "description": "单条消息流的处理时限，毫秒；与 RPC 请求超时独立。"
        }
      },
      "required": [
        "maxFramePayloadBytes",
        "maxEncodedMessageBytes",
        "maxDecodedMessageBytes",
        "receiveBudgetBytes",
        "normalStreams",
        "smallStreams",
        "controlStreams",
        "smallMessageBytes",
        "smallReceiveBudgetBytes",
        "controlMessageBytes",
        "controlReceiveBudgetBytes",
        "connectionWindowBytes",
        "idleTimeoutMs",
        "streamTimeoutMs"
