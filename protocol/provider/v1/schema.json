{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-pet.dev/protocol/provider/v1/schema.json",
  "title": "CodePet Provider Protocol v1",
  "$defs": {
    "ProviderPingRequest": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "hostSessionId": {
          "type": "string",
          "minLength": 1
        },
        "clients": {
          "$ref": "../../core/v1/schema.json#/$defs/ClientConnectionsSnapshot"
        },
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderInstanceRoute"
          }
        }
      },
      "required": [
        "sequence",
        "hostSessionId",
        "clients",
        "instances"
      ],
      "additionalProperties": false
    },
    "ProviderPingResponse": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "clientsRevision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "sequence",
        "clientsRevision"
      ],
      "additionalProperties": false
    },
    "ApprovalRequestedEvent": {
      "type": "object",
      "properties": {
        "approval": {
          "$ref": "../../agent/v1/schema.json#/$defs/Approval"
        }
      },
      "required": [
        "approval"
      ],
      "additionalProperties": false
    },
    "ApprovalResolveRequest": {
      "type": "object",
      "properties": {
        "approval": {
          "$ref": "#/$defs/ProviderResourceId"
        },
        "decision": {
          "$ref": "../../agent/v1/schema.json#/$defs/ApprovalDecision"
        }
      },
      "required": [
        "approval",
        "decision"
      ],
      "additionalProperties": false
    },
    "ApprovalResolveResponse": {
      "type": "object",
      "properties": {
        "approval": {
          "$ref": "../../agent/v1/schema.json#/$defs/Approval"
        }
      },
      "required": [
        "approval"
      ],
      "additionalProperties": false
    },
    "ApprovalResolvedEvent": {
      "type": "object",
      "properties": {
        "approval": {
          "$ref": "../../agent/v1/schema.json#/$defs/Approval"
        }
      },
      "required": [
        "approval"
      ],
      "additionalProperties": false
    },
    "ConversationAcquireInteractionRequest": {
      "type": "object",
      "properties": {
        "conversation": {
          "$ref": "#/$defs/ProviderResourceId"
        }
      },
      "required": [
        "conversation"
      ],
      "additionalProperties": false
    },
    "ConversationAcquireInteractionResponse": {
      "type": "object",
      "properties": {
        "selection": {
          "$ref": "../../agent/v1/schema.json#/$defs/TurnSelection"
        },
        "leaseExpiresAt": {
          "$ref": "../../core/v1/schema.json#/$defs/TimestampMs"
        }
      },
      "required": [
        "selection"
      ],
      "additionalProperties": false
    },
    "ConversationCreateRequest": {
      "type": "object",
      "properties": {
        "route": {
          "$ref": "#/$defs/ProviderInstanceRoute"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "permissionLevel": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoningEffort": {
          "type": "string",
          "minLength": 1
        },
        "workspaceRoot": {
          "type": "string",
          "minLength": 1
        },
        "workspaceMode": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "$ref": "#/$defs/ProviderResourceId"
        },
        "extension": {
          "$ref": "#/$defs/ProviderExtension"
        }
      },
      "required": [
        "route",
        "permissionLevel"
      ],
      "additionalProperties": false
    },
    "ConversationCreateResponse": {
      "type": "object",
      "properties": {
        "conversation": {
          "$ref": "../../agent/v1/schema.json#/$defs/Conversation"
        }
      },
      "required": [
        "conversation"
      ],
      "additionalProperties": false
    },
    "ConversationGetRequest": {
      "type": "object",
      "properties": {
        "conversation": {
          "$ref": "#/$defs/ProviderResourceId"
        },
        "cursor": {
          "$ref": "../../core/v1/schema.json#/$defs/Cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum number of native conversation turns to include in this history page."
        }
      },
      "required": [
        "conversation"
      ],
      "additionalProperties": false
    },
    "ConversationGetResponse": {
      "type": "object",
      "properties": {
        "conversation": {
          "$ref": "../../agent/v1/schema.json#/$defs/Conversation"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "../../agent/v1/schema.json#/$defs/ConversationItem"
          }
        },
        "pageInfo": {
          "$ref": "../../core/v1/schema.json#/$defs/PageInfo"
        }
      },
      "required": [
        "conversation",
        "items"
      ],
      "additionalProperties": false
    },
    "ConversationListRequest": {
      "type": "object",
      "properties": {
        "route": {
          "$ref": "#/$defs/ProviderInstanceRoute"
        },
        "projectFilter": {
          "$ref": "#/$defs/ConversationProjectFilter"
        },
        "cursor": {
          "$ref": "../../core/v1/schema.json#/$defs/Cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "route",
        "projectFilter"
      ],
      "additionalProperties": false
    },
    "ConversationListResponse": {
      "type": "object",
      "properties": {
        "conversations": {
          "type": "array",
          "items": {
            "$ref": "../../agent/v1/schema.json#/$defs/Conversation"
          }
        },
        "pageInfo": {
          "$ref": "../../core/v1/schema.json#/$defs/PageInfo"
        }
      },
      "required": [
        "conversations",
        "pageInfo"
      ],
      "additionalProperties": false
    },
    "ConversationProjectFilter": {
      "oneOf": [
        {
          "$ref": "#/$defs/ConversationProjectFilterAll"
        },
        {
          "$ref": "#/$defs/ConversationProjectFilterStandalone"
        },
        {
          "$ref": "#/$defs/ConversationProjectFilterProject"
        }
      ]
    },
    "ConversationProjectFilterAll": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ConversationProjectFilterAllKind"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "ConversationProjectFilterAllKind": {
      "type": "string",
      "enum": [
        "all"
      ]
    },
    "ConversationProjectFilterStandalone": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ConversationProjectFilterStandaloneKind"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "ConversationProjectFilterStandaloneKind": {
      "type": "string",
      "enum": [
        "standalone"
      ]
    },
    "ConversationProjectFilterProject": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ConversationProjectFilterProjectKind"
        },
        "project": {
          "$ref": "#/$defs/ProviderResourceId"
        }
      },
      "required": [
        "kind",
        "project"
      ],
      "additionalProperties": false
    },
    "ConversationProjectFilterProjectKind": {
      "type": "string",
      "enum": [
        "project"
      ]
    },
    "ConversationSearchRequest": {
      "type": "object",
      "properties": {
        "route": {
          "$ref": "#/$defs/ProviderInstanceRoute"
        },
        "searchTerm": {
          "type": "string",
          "minLength": 1
        },
        "cursor": {
          "$ref": "../../core/v1/schema.json#/$defs/Cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "route",
        "searchTerm"
      ],
      "additionalProperties": false
    },
    "ConversationSearchResponse": {
      "type": "object",
      "properties": {
        "conversations": {
          "type": "array",
          "items": {
            "$ref": "../../agent/v1/schema.json#/$defs/Conversation"
          }
        },
        "pageInfo": {
          "$ref": "../../core/v1/schema.json#/$defs/PageInfo"
        }
      },
      "required": [
        "conversations",
        "pageInfo"
      ],
      "additionalProperties": false
    },
    "ConversationUpsertedEvent": {
      "type": "object",
      "properties": {
        "conversation": {
          "$ref": "../../agent/v1/schema.json#/$defs/Conversation"
        }
      },
      "required": [
        "conversation"
      ],
      "additionalProperties": false
    },
    "ConversationItemUpsertedEvent": {
      "type": "object",
      "properties": {
        "item": {
          "$ref": "../../agent/v1/schema.json#/$defs/ConversationItem"
        }
      },
      "required": [
        "item"
      ],
      "additionalProperties": false
    },
    "HarnessDescriptor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "executablePath": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "displayName"
      ],
      "additionalProperties": false
    },
    "InstanceCapabilitiesRequest": {
      "type": "object",
      "properties": {
        "route": {
          "$ref": "#/$defs/ProviderInstanceRoute"
        }
      },
      "required": [
        "route"
      ],
      "additionalProperties": false
    },
    "InstanceCapabilitiesResponse": {
      "type": "object",
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/ProviderCapabilities"
        }
      },
      "required": [
        "capabilities"
      ],
      "additionalProperties": false
    },
    "InstanceCreateRequest": {
      "type": "object",
      "properties": {
        "route": {
          "$ref": "#/$defs/ProviderInstanceRoute"
        },
        "instanceKind": {
          "$ref": "#/$defs/ProviderInstanceKind"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "settings": {
          "$ref": "../../core/v1/schema.json#/$defs/JsonObject"
        }
      },
      "required": [
        "route",
        "instanceKind",
        "displayName",
        "settings"
      ],
      "additionalProperties": false
    },
    "InstanceCreateResponse": {
      "type": "object",
      "properties": {
        "instance": {
          "$ref": "#/$defs/ProviderInstance"
        }
      },
      "required": [
        "instance"
      ],
      "additionalProperties": false
    },
    "InstanceDestroyRequest": {
      "type": "object",
      "properties": {
        "route": {
          "$ref": "#/$defs/ProviderInstanceRoute"
        }
      },
      "required": [
        "route"
      ],
      "additionalProperties": false
    },
    "InstanceDestroyResponse": {
      "type": "object",
      "properties": {
        "destroyed": {
          "type": "boolean"
        }
      },
      "required": [
        "destroyed"
      ],
      "additionalProperties": false
    },
    "InstanceStartRequest": {
      "type": "object",
      "properties": {
        "route": {
          "$ref": "#/$defs/ProviderInstanceRoute"
        }
      },
      "required": [
        "route"
      ],
      "additionalProperties": false
    },
    "InstanceStartResponse": {
      "type": "object",
      "properties": {
        "instance": {
          "$ref": "#/$defs/ProviderInstance"
        }
      },
      "required": [
        "instance"
      ],
      "additionalProperties": false
    },
    "ProviderInstanceKind": {
      "type": "string",
      "minLength": 1
    },
    "InstanceStatus": {
      "type": "string",
      "enum": [
        "created",
        "starting",
        "ready",
        "stopping",
        "stopped",
        "error"
      ]
    },
    "InstanceStatusChangedEvent": {
      "type": "object",
      "properties": {
        "instance": {
          "$ref": "#/$defs/ProviderInstance"
        },
        "previousStatus": {
          "$ref": "#/$defs/InstanceStatus"
        }
      },
      "required": [
        "instance"
      ],
      "additionalProperties": false
    },
    "InstanceStopRequest": {
      "type": "object",
      "properties": {
        "route": {
          "$ref": "#/$defs/ProviderInstanceRoute"
        }
      },
      "required": [
        "route"
      ],
      "additionalProperties": false
    },
    "InstanceStopResponse": {
      "type": "object",
      "properties": {
        "instance": {
          "$ref": "#/$defs/ProviderInstance"
        }
      },
      "required": [
        "instance"
      ],
      "additionalProperties": false
    },
    "ProviderCapability": {
      "type": "string",
      "enum": [
        "project.list",
        "project.get",
        "project.create",
        "project.update",
        "project.delete",
        "conversation.list",
        "conversation.search",
        "conversation.get",
        "conversation.create",
        "turn.start",
        "turn.steer",
        "turn.interrupt",
        "approval.resolve"
      ]
    },
    "ProviderCapabilities": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderCapability"
          },
          "uniqueItems": true
        },
        "turnSend": {
          "$ref": "../../agent/v1/schema.json#/$defs/TurnSendCapabilities"
        },
        "conversationCreate": {
          "$ref": "../../agent/v1/schema.json#/$defs/ConversationCreateCapabilities"
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderExtension"
          }
        }
      },
      "required": [
        "revision",
        "methods",
        "extensions"
      ],
      "additionalProperties": false
    },
    "ProjectChangedEvent": {
      "type": "object",
      "properties": {
        "project": {
          "$ref": "#/$defs/ProviderResourceId"
        },
        "changeType": {
          "$ref": "../../agent/v1/schema.json#/$defs/ProjectChangeType"
        }
      },
      "required": [
        "project",
        "changeType"
      ],
      "additionalProperties": false
    },
    "ProjectCreateRequest": {
      "type": "object",
      "properties": {
        "route": {
          "$ref": "#/$defs/ProviderInstanceRoute"
        },
        "idempotencyKey": {
          "$ref": "../../core/v1/schema.json#/$defs/RequestId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "roots": {
          "type": "array",
          "items": {
            "$ref": "../../agent/v1/schema.json#/$defs/ProjectRoot"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "route",
        "idempotencyKey",
        "name",
        "roots",
        "metadata"
      ],
      "additionalProperties": false
    },
    "ProjectCreateResponse": {
      "type": "object",
      "properties": {
        "project": {
          "$ref": "../../agent/v1/schema.json#/$defs/Project"
        }
      },
      "required": [
        "project"
      ],
      "additionalProperties": false
    },
    "ProjectDeleteRequest": {
      "type": "object",
      "properties": {
        "project": {
          "$ref": "#/$defs/ProviderResourceId"
        }
      },
      "required": [
        "project"
      ],
      "additionalProperties": false
    },
    "ProjectDeleteResponse": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "ProjectGetRequest": {
      "type": "object",
      "properties": {
        "project": {
          "$ref": "#/$defs/ProviderResourceId"
        }
      },
      "required": [
        "project"
      ],
      "additionalProperties": false
    },
    "ProjectGetResponse": {
      "type": "object",
      "properties": {
        "project": {
          "$ref": "../../agent/v1/schema.json#/$defs/Project"
        }
      },
      "required": [
        "project"
      ],
      "additionalProperties": false
    },
    "ProjectListRequest": {
      "type": "object",
      "properties": {
        "route": {
          "$ref": "#/$defs/ProviderInstanceRoute"
        },
        "cursor": {
          "$ref": "../../core/v1/schema.json#/$defs/Cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "route"
      ],
      "additionalProperties": false
    },
    "ProjectListResponse": {
      "type": "object",
      "properties": {
        "projects": {
          "type": "array",
          "items": {
            "$ref": "../../agent/v1/schema.json#/$defs/Project"
          }
        },
        "pageInfo": {
          "$ref": "../../core/v1/schema.json#/$defs/PageInfo"
        }
      },
      "required": [
        "projects",
        "pageInfo"
      ],
      "additionalProperties": false
    },
    "ProjectUpdateRequest": {
      "type": "object",
      "properties": {
        "project": {
          "$ref": "#/$defs/ProviderResourceId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "roots": {
          "type": "array",
          "items": {
            "$ref": "../../agent/v1/schema.json#/$defs/ProjectRoot"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "project"
      ],
      "additionalProperties": false
    },
    "ProjectUpdateResponse": {
      "type": "object",
      "properties": {
        "project": {
          "$ref": "../../agent/v1/schema.json#/$defs/Project"
        }
      },
      "required": [
        "project"
      ],
      "additionalProperties": false
    },
    "ProviderDescribeRequest": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "ProviderDescribeResponse": {
      "type": "object",
      "properties": {
        "plugin": {
          "$ref": "#/$defs/ProviderPluginDescriptor"
        }
      },
      "required": [
        "plugin"
      ],
      "additionalProperties": false
    },
    "RuntimeCandidateSource": {
      "type": "string",
      "enum": [
        "configured",
        "environment",
        "current-path",
        "login-shell",
        "macos-application",
        "windows-application"
      ]
    },
    "RuntimeCandidate": {
      "type": "object",
      "properties": {
        "executablePath": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/RuntimeCandidateSource"
        }
      },
      "required": [
        "executablePath",
        "source"
      ],
      "additionalProperties": false
    },
    "RuntimeInstallation": {
      "type": "object",
      "properties": {
        "executablePath": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/RuntimeCandidateSource"
        }
      },
      "required": [
        "executablePath",
        "version",
        "source"
      ],
      "additionalProperties": false
    },
    "RuntimeGetInstalledRequest": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "RuntimeGetInstalledResponse": {
      "type": "object",
      "properties": {
        "installed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuntimeInstallation"
          }
        },
        "selected": {
          "$ref": "#/$defs/RuntimeInstallation"
        }
      },
      "required": [
        "installed"
      ],
      "additionalProperties": false
    },
    "RuntimeSelectRequest": {
      "type": "object",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/RuntimeCandidate"
        }
      },
      "required": [
        "candidate"
      ],
      "additionalProperties": false
    },
    "RuntimeSelectResponse": {
      "type": "object",
      "properties": {
        "selected": {
          "$ref": "#/$defs/RuntimeInstallation"
        }
      },
      "required": [
        "selected"
      ],
      "additionalProperties": false
    },
    "ProviderExtension": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "$ref": "../../core/v1/schema.json#/$defs/JsonObject"
        }
      },
      "required": [
        "namespace",
        "data"
      ],
      "additionalProperties": false
    },
    "ProviderInitializeRequest": {
      "type": "object",
      "properties": {
        "hostClientId": {
          "$ref": "../../core/v1/schema.json#/$defs/ClientId"
        },
        "hostDeviceId": {
          "$ref": "../../core/v1/schema.json#/$defs/DeviceId"
        },
        "hostVersion": {
          "type": "string",
          "minLength": 1
        },
        "supportedVersions": {
          "$ref": "../../core/v1/schema.json#/$defs/VersionRange"
        }
      },
      "required": [
        "hostClientId",
        "hostDeviceId",
        "hostVersion",
        "supportedVersions"
      ],
      "additionalProperties": false
    },
    "ProviderInitializeResponse": {
      "type": "object",
      "properties": {
        "selectedVersion": {
          "$ref": "../../core/v1/schema.json#/$defs/ProtocolVersion"
        },
        "plugin": {
          "$ref": "#/$defs/ProviderPluginDescriptor"
        }
      },
      "required": [
        "selectedVersion",
        "plugin"
      ],
      "additionalProperties": false
    },
    "ProviderInstance": {
      "type": "object",
      "properties": {
        "route": {
          "$ref": "#/$defs/ProviderInstanceRoute"
        },
        "pluginId": {
          "$ref": "../../core/v1/schema.json#/$defs/ProviderPluginId"
        },
        "instanceKind": {
          "$ref": "#/$defs/ProviderInstanceKind"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "harness": {
          "$ref": "#/$defs/HarnessDescriptor"
        },
        "status": {
          "$ref": "#/$defs/InstanceStatus"
        },
        "authentication": {
          "$ref": "../../agent/v1/schema.json#/$defs/ProviderAuthentication"
        },
        "usage": {
          "$ref": "../../agent/v1/schema.json#/$defs/ProviderUsage"
        },
        "capabilities": {
          "$ref": "#/$defs/ProviderCapabilities"
        }
      },
      "required": [
        "route",
        "pluginId",
        "instanceKind",
        "displayName",
        "harness",
