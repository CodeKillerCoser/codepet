{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-pet.dev/protocol/provider/v1/schema.json",
  "title": "CodePet Provider Protocol v1",
  "$defs": {
    "ApprovalDecision": {
      "type": "string",
      "enum": ["approve", "deny"]
    },
    "ApprovalRequestedEvent": {
      "type": "object",
      "properties": {
        "approval": { "$ref": "#/$defs/ProviderApproval" }
      },
      "required": ["approval"],
      "additionalProperties": false
    },
    "ApprovalResolveRequest": {
      "type": "object",
      "properties": {
        "approval": { "$ref": "#/$defs/RoutedResourceId" },
        "decision": { "$ref": "#/$defs/ApprovalDecision" }
      },
      "required": ["approval", "decision"],
      "additionalProperties": false
    },
    "ApprovalResolveResponse": {
      "type": "object",
      "properties": {
        "approval": { "$ref": "#/$defs/ProviderApproval" }
      },
      "required": ["approval"],
      "additionalProperties": false
    },
    "ApprovalResolvedEvent": {
      "type": "object",
      "properties": {
        "approval": { "$ref": "#/$defs/ProviderApproval" }
      },
      "required": ["approval"],
      "additionalProperties": false
    },
    "ApprovalStatus": {
      "type": "string",
      "enum": ["pending", "approved", "denied", "expired"]
    },
    "ConversationAcquireInteractionRequest": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "#/$defs/RoutedResourceId" }
      },
      "required": ["conversation"],
      "additionalProperties": false
    },
    "ConversationAcquireInteractionResponse": {
      "type": "object",
      "properties": {
        "selection": { "$ref": "#/$defs/TurnSelection" },
        "leaseExpiresAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" }
      },
      "required": ["selection"],
      "additionalProperties": false
    },
    "ConversationCreateRequest": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/ProviderInstanceRoute" },
        "title": { "type": "string", "minLength": 1 },
        "permissionLevel": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "type": "string", "minLength": 1 },
        "workspaceRoot": { "type": "string", "minLength": 1 },
        "workspaceMode": { "type": "string", "minLength": 1 },
        "project": { "$ref": "#/$defs/RoutedResourceId" },
        "extension": { "$ref": "#/$defs/ProviderExtension" }
      },
      "required": ["route", "permissionLevel"],
      "additionalProperties": false
    },
    "ConversationCreateResponse": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "#/$defs/ProviderConversation" }
      },
      "required": ["conversation"],
      "additionalProperties": false
    },
    "ConversationGetRequest": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "#/$defs/RoutedResourceId" },
        "cursor": { "$ref": "../../core/v1/schema.json#/$defs/Cursor" },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum number of native conversation turns to include in this history page."
        }
      },
      "required": ["conversation"],
      "additionalProperties": false
    },
    "ConversationGetResponse": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "#/$defs/ProviderConversation" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/ConversationItem" }
        },
        "pageInfo": { "$ref": "../../core/v1/schema.json#/$defs/PageInfo" }
      },
      "required": ["conversation", "items"],
      "additionalProperties": false
    },
    "ConversationContent": {
      "type": "object",
      "properties": {
        "contentId": { "$ref": "../../core/v1/schema.json#/$defs/NativeResourceId" },
        "kind": { "$ref": "#/$defs/ConversationContentKind" },
        "text": { "type": "string" }
      },
      "required": ["contentId", "kind", "text"],
      "additionalProperties": false
    },
    "ConversationContentKind": {
      "type": "string",
      "enum": ["text", "reasoning-summary", "command", "output", "activity-summary"]
    },
    "ToolAnnotations": {
      "type": "object",
      "properties": {
        "readOnly": { "type": "boolean" },
        "destructive": { "type": "boolean" },
        "idempotent": { "type": "boolean" },
        "openWorld": { "type": "boolean" }
      },
      "additionalProperties": false,
      "description": "Advisory UI hints only; hosts must not use these fields as authorization decisions."
    },
    "ToolCategory": {
      "type": "string",
      "enum": ["command", "read", "write", "search", "web", "agent", "computer", "media", "other"]
    },
    "ToolCommandAction": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/ToolCommandActionKind" },
        "command": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "query": { "type": "string" }
      },
      "required": ["kind", "command"],
      "additionalProperties": false
    },
    "ToolCommandActionKind": {
      "type": "string",
      "enum": ["execute", "read", "list", "search", "unknown"]
    },
    "ToolCommandDetails": {
      "type": "object",
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string", "minLength": 1 },
        "exitCode": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "processId": { "type": "string", "minLength": 1 },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/ToolCommandAction" }
        }
      },
      "required": ["command"],
      "additionalProperties": false
    },
    "ToolContent": {
      "type": "object",
      "properties": {
        "contentId": { "$ref": "../../core/v1/schema.json#/$defs/NativeResourceId" },
        "kind": { "$ref": "#/$defs/ToolContentKind" },
        "text": { "type": "string" },
        "uri": { "type": "string", "minLength": 1 },
        "mimeType": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "truncated": { "type": "boolean" },
        "totalBytes": { "type": "integer", "minimum": 0 }
      },
      "required": ["contentId", "kind"],
      "additionalProperties": false,
      "description": "Tool result content discriminated by kind; providers validate kind-specific optional fields and keep inline values frame-bounded."
    },
    "ToolContentKind": {
      "type": "string",
      "enum": ["text", "image", "audio", "resource-link", "embedded-resource"]
    },
    "ToolExecutionError": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": { "$ref": "../../core/v1/schema.json#/$defs/JsonObject" }
      },
      "required": ["message"],
      "additionalProperties": false
    },
    "ToolInvocation": {
      "type": "object",
      "properties": {
        "callId": { "$ref": "../../core/v1/schema.json#/$defs/NativeResourceId" },
        "name": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/ToolCategory" },
        "origin": { "$ref": "#/$defs/ToolOrigin" },
        "input": { "$ref": "../../core/v1/schema.json#/$defs/JsonObject" },
        "rawInput": { "type": "string" },
        "result": { "$ref": "#/$defs/ToolResult" },
        "timing": { "$ref": "#/$defs/ToolTiming" },
        "command": { "$ref": "#/$defs/ToolCommandDetails" },
        "annotations": { "$ref": "#/$defs/ToolAnnotations" },
        "extension": { "$ref": "#/$defs/ProviderExtension" }
      },
      "required": ["callId", "name", "category", "origin", "input"],
      "additionalProperties": false,
      "description": "Provider-neutral tool-call envelope. Input and structured output may vary by tool; lifecycle remains ConversationItem.status."
    },
    "ToolOrigin": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/ToolOriginKind" },
        "name": { "type": "string", "minLength": 1 }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "ToolOriginKind": {
      "type": "string",
      "enum": ["builtin", "mcp", "plugin", "server", "custom", "unknown"]
    },
    "ToolResult": {
      "type": "object",
      "properties": {
        "content": {
          "type": "array",
          "items": { "$ref": "#/$defs/ToolContent" }
        },
        "structuredContent": { "$ref": "../../core/v1/schema.json#/$defs/JsonObject" },
        "error": { "$ref": "#/$defs/ToolExecutionError" }
      },
      "required": ["content"],
      "additionalProperties": false
    },
    "ToolTiming": {
      "type": "object",
      "properties": {
        "startedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "completedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "durationMs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "ConversationItem": {
      "type": "object",
      "properties": {
        "resource": { "$ref": "#/$defs/RoutedResourceId" },
        "turn": { "$ref": "#/$defs/RoutedResourceId" },
        "conversation": { "$ref": "#/$defs/RoutedResourceId" },
        "kind": { "$ref": "#/$defs/ConversationItemKind" },
        "status": { "$ref": "#/$defs/ConversationItemStatus" },
        "role": { "$ref": "#/$defs/ConversationItemRole" },
        "title": { "type": "string", "minLength": 1 },
        "contents": {
          "type": "array",
          "items": { "$ref": "#/$defs/ConversationContent" }
        },
        "relatedItem": { "$ref": "#/$defs/RoutedResourceId" },
        "approval": { "$ref": "#/$defs/ProviderApproval" },
        "tool": { "$ref": "#/$defs/ToolInvocation" }
      },
      "required": ["resource", "turn", "conversation", "kind", "status", "contents"],
      "additionalProperties": false
    },
    "ConversationItemKind": {
      "type": "string",
      "enum": ["message", "reasoning", "command", "file-change", "tool", "approval", "unknown"]
    },
    "ConversationItemRole": {
      "type": "string",
      "enum": ["user", "assistant"]
    },
    "ConversationItemStatus": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "interrupted",
        "declined",
        "approved",
        "denied",
        "expired",
        "unknown"
      ]
    },
    "ConversationListRequest": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/ProviderInstanceRoute" },
        "projectFilter": { "$ref": "#/$defs/ConversationProjectFilter" },
        "cursor": { "$ref": "../../core/v1/schema.json#/$defs/Cursor" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "required": ["route", "projectFilter"],
      "additionalProperties": false
    },
    "ConversationListResponse": {
      "type": "object",
      "properties": {
        "conversations": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProviderConversation" }
        },
        "pageInfo": { "$ref": "../../core/v1/schema.json#/$defs/PageInfo" }
      },
      "required": ["conversations", "pageInfo"],
      "additionalProperties": false
    },
    "ConversationProjectFilter": {
      "oneOf": [
        { "$ref": "#/$defs/ConversationProjectFilterAll" },
        { "$ref": "#/$defs/ConversationProjectFilterStandalone" },
        { "$ref": "#/$defs/ConversationProjectFilterProject" }
      ]
    },
    "ConversationProjectFilterAll": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/ConversationProjectFilterAllKind" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "ConversationProjectFilterAllKind": {
      "type": "string",
      "enum": ["all"]
    },
    "ConversationProjectFilterStandalone": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/ConversationProjectFilterStandaloneKind" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "ConversationProjectFilterStandaloneKind": {
      "type": "string",
      "enum": ["standalone"]
    },
    "ConversationProjectFilterProject": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/ConversationProjectFilterProjectKind" },
        "project": { "$ref": "#/$defs/RoutedResourceId" }
      },
      "required": ["kind", "project"],
      "additionalProperties": false
    },
    "ConversationProjectFilterProjectKind": {
      "type": "string",
      "enum": ["project"]
    },
    "ConversationSearchRequest": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/ProviderInstanceRoute" },
        "searchTerm": { "type": "string", "minLength": 1 },
        "cursor": { "$ref": "../../core/v1/schema.json#/$defs/Cursor" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "required": ["route", "searchTerm"],
      "additionalProperties": false
    },
    "ConversationSearchResponse": {
      "type": "object",
      "properties": {
        "conversations": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProviderConversation" }
        },
        "pageInfo": { "$ref": "../../core/v1/schema.json#/$defs/PageInfo" }
      },
      "required": ["conversations", "pageInfo"],
      "additionalProperties": false
    },
    "ConversationStatus": {
      "type": "string",
      "enum": ["idle", "running", "waiting-approval", "waiting-user-input", "error", "archived"]
    },
    "ConversationUpsertedEvent": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "#/$defs/ProviderConversation" }
      },
      "required": ["conversation"],
      "additionalProperties": false
    },
    "ConversationItemUpsertedEvent": {
      "type": "object",
      "properties": {
        "item": { "$ref": "#/$defs/ConversationItem" }
      },
      "required": ["item"],
      "additionalProperties": false
    },
    "ChoiceOption": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "enabled": { "type": "boolean" },
        "disabledReason": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "displayName"],
      "additionalProperties": false
    },
    "ChoiceSet": {
      "type": "object",
      "properties": {
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/ChoiceOption" },
          "minItems": 1
        },
        "defaultId": { "type": "string", "minLength": 1 }
      },
      "required": ["options"],
      "additionalProperties": false
    },
    "FlatModelCatalogKind": {
      "type": "string",
      "enum": ["flat"]
    },
    "FlatModelSelection": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/FlatModelCatalogKind" },
        "modelId": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "modelId"],
      "additionalProperties": false
    },
    "FlatModelCatalog": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/FlatModelCatalogKind" },
        "models": {
          "type": "array",
          "items": { "$ref": "#/$defs/ChoiceOption" },
          "minItems": 1
        },
        "defaultSelection": { "$ref": "#/$defs/FlatModelSelection" }
      },
      "required": ["kind", "models"],
      "additionalProperties": false
    },
    "GroupedModelCatalogKind": {
      "type": "string",
      "enum": ["grouped"]
    },
    "GroupedModelProvider": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "models": {
          "type": "array",
          "items": { "$ref": "#/$defs/ChoiceOption" },
          "minItems": 1
        }
      },
      "required": ["id", "displayName", "models"],
      "additionalProperties": false
    },
    "GroupedModelSelection": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/GroupedModelCatalogKind" },
        "providerId": { "type": "string", "minLength": 1 },
        "modelId": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "providerId", "modelId"],
      "additionalProperties": false
    },
    "GroupedModelCatalog": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/GroupedModelCatalogKind" },
        "providers": {
          "type": "array",
          "items": { "$ref": "#/$defs/GroupedModelProvider" },
          "minItems": 1
        },
        "defaultSelection": { "$ref": "#/$defs/GroupedModelSelection" }
      },
      "required": ["kind", "providers"],
      "additionalProperties": false
    },
    "ModelCatalog": {
      "oneOf": [
        { "$ref": "#/$defs/FlatModelCatalog" },
        { "$ref": "#/$defs/GroupedModelCatalog" }
      ]
    },
    "ModelSelection": {
      "oneOf": [
        { "$ref": "#/$defs/FlatModelSelection" },
        { "$ref": "#/$defs/GroupedModelSelection" }
      ]
    },
    "TurnSendCapabilities": {
      "type": "object",
      "properties": {
        "accessMode": { "$ref": "#/$defs/ChoiceSet" },
        "reasoningEffort": { "$ref": "#/$defs/ChoiceSet" },
        "modelCatalog": { "$ref": "#/$defs/ModelCatalog" }
      },
      "additionalProperties": false
    },
    "ConversationCreateCapabilities": {
      "type": "object",
      "properties": {
        "supportsTitle": { "type": "boolean" },
        "selection": { "$ref": "#/$defs/TurnSendCapabilities" },
        "workspaceMode": { "$ref": "#/$defs/ChoiceSet" }
      },
      "required": ["supportsTitle"],
      "additionalProperties": false
    },
    "TurnInputKind": {
      "type": "string",
      "enum": ["text"]
    },
    "TurnInput": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/TurnInputKind" },
        "text": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "text"],
      "additionalProperties": false
    },
    "TurnSelection": {
      "type": "object",
      "properties": {
        "accessModeId": { "type": "string", "minLength": 1 },
        "reasoningEffortId": { "type": "string", "minLength": 1 },
        "model": { "$ref": "#/$defs/ModelSelection" }
      },
      "additionalProperties": false
    },
    "HarnessDescriptor": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "executablePath": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "displayName"],
      "additionalProperties": false
    },
    "InstanceCapabilitiesRequest": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/ProviderInstanceRoute" }
      },
      "required": ["route"],
      "additionalProperties": false
    },
    "InstanceCapabilitiesResponse": {
      "type": "object",
      "properties": {
        "capabilities": { "$ref": "#/$defs/ProviderCapabilities" }
      },
      "required": ["capabilities"],
      "additionalProperties": false
    },
    "InstanceCreateRequest": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/ProviderInstanceRoute" },
        "instanceKind": { "$ref": "#/$defs/ProviderInstanceKind" },
        "displayName": { "type": "string", "minLength": 1 },
        "settings": { "$ref": "../../core/v1/schema.json#/$defs/JsonObject" }
      },
      "required": ["route", "instanceKind", "displayName", "settings"],
      "additionalProperties": false
    },
    "InstanceCreateResponse": {
      "type": "object",
      "properties": {
        "instance": { "$ref": "#/$defs/ProviderInstance" }
      },
      "required": ["instance"],
      "additionalProperties": false
    },
    "InstanceDestroyRequest": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/ProviderInstanceRoute" }
      },
      "required": ["route"],
      "additionalProperties": false
    },
    "InstanceDestroyResponse": {
      "type": "object",
      "properties": {
        "destroyed": { "type": "boolean" }
      },
      "required": ["destroyed"],
      "additionalProperties": false
    },
    "InstanceStartRequest": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/ProviderInstanceRoute" }
      },
      "required": ["route"],
      "additionalProperties": false
    },
    "InstanceStartResponse": {
      "type": "object",
      "properties": {
        "instance": { "$ref": "#/$defs/ProviderInstance" }
      },
      "required": ["instance"],
      "additionalProperties": false
    },
    "ProviderInstanceKind": {
      "type": "string",
      "minLength": 1
    },
    "InstanceStatus": {
      "type": "string",
      "enum": ["created", "starting", "ready", "stopping", "stopped", "error"]
    },
    "InstanceStatusChangedEvent": {
      "type": "object",
      "properties": {
        "instance": { "$ref": "#/$defs/ProviderInstance" },
        "previousStatus": { "$ref": "#/$defs/InstanceStatus" }
      },
      "required": ["instance"],
      "additionalProperties": false
    },
    "InstanceStopRequest": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/ProviderInstanceRoute" }
      },
      "required": ["route"],
      "additionalProperties": false
    },
    "InstanceStopResponse": {
      "type": "object",
      "properties": {
        "instance": { "$ref": "#/$defs/ProviderInstance" }
      },
      "required": ["instance"],
      "additionalProperties": false
    },
    "ProviderApproval": {
      "type": "object",
      "properties": {
        "resource": { "$ref": "#/$defs/RoutedResourceId" },
        "conversation": { "$ref": "#/$defs/RoutedResourceId" },
        "turn": { "$ref": "#/$defs/RoutedResourceId" },
        "kind": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "status": { "$ref": "#/$defs/ApprovalStatus" },
        "decisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/ApprovalDecision" },
          "minItems": 1,
          "uniqueItems": true
        },
        "requestedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "resolvedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "decision": { "$ref": "#/$defs/ApprovalDecision" },
        "extension": { "$ref": "#/$defs/ProviderExtension" }
      },
      "required": ["resource", "conversation", "turn", "kind", "title", "status", "decisions"],
      "additionalProperties": false
    },
    "ProviderCapability": {
      "type": "string",
      "enum": [
        "project.list",
        "project.get",
        "project.create",
        "project.update",
        "project.delete",
        "conversation.list",
        "conversation.search",
        "conversation.get",
        "conversation.create",
        "turn.start",
        "turn.steer",
        "turn.interrupt",
        "approval.resolve"
      ]
    },
    "ProviderCapabilities": {
      "type": "object",
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "methods": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProviderCapability" },
          "uniqueItems": true
        },
        "turnSend": { "$ref": "#/$defs/TurnSendCapabilities" },
        "conversationCreate": { "$ref": "#/$defs/ConversationCreateCapabilities" },
        "extensions": {
          "type": "array",
