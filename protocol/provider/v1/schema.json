{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-pet.dev/protocol/provider/v1/schema.json",
  "title": "CodePet Provider Protocol v1",
  "$defs": {
    "ApprovalDecision": {
      "type": "string",
      "enum": ["approve", "deny"]
    },
    "ApprovalRequestedEvent": {
      "type": "object",
      "properties": {
        "approval": { "$ref": "#/$defs/ProviderApproval" }
      },
      "required": ["approval"],
      "additionalProperties": false
    },
    "ApprovalResolveRequest": {
      "type": "object",
      "properties": {
        "approval": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "decision": { "$ref": "#/$defs/ApprovalDecision" }
      },
      "required": ["approval", "decision"],
      "additionalProperties": false
    },
    "ApprovalResolveResponse": {
      "type": "object",
      "properties": {
        "approval": { "$ref": "#/$defs/ProviderApproval" }
      },
      "required": ["approval"],
      "additionalProperties": false
    },
    "ApprovalResolvedEvent": {
      "type": "object",
      "properties": {
        "approval": { "$ref": "#/$defs/ProviderApproval" }
      },
      "required": ["approval"],
      "additionalProperties": false
    },
    "ApprovalStatus": {
      "type": "string",
      "enum": ["pending", "approved", "denied", "expired"]
    },
    "ConversationCreateRequest": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/ProviderInstanceRoute" },
        "title": { "type": "string", "minLength": 1 },
        "permissionLevel": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "type": "string", "minLength": 1 },
        "workspaceRoot": { "type": "string", "minLength": 1 },
        "extension": { "$ref": "#/$defs/ProviderExtension" }
      },
      "required": ["route", "permissionLevel"],
      "additionalProperties": false
    },
    "ConversationCreateResponse": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "#/$defs/ProviderConversation" }
      },
      "required": ["conversation"],
      "additionalProperties": false
    },
    "ConversationGetRequest": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" }
      },
      "required": ["conversation"],
      "additionalProperties": false
    },
    "ConversationGetResponse": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "#/$defs/ProviderConversation" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/ConversationItem" }
        }
      },
      "required": ["conversation", "items"],
      "additionalProperties": false
    },
    "ConversationContent": {
      "type": "object",
      "properties": {
        "contentId": { "$ref": "../../core/v1/schema.json#/$defs/NativeResourceId" },
        "kind": { "$ref": "#/$defs/ConversationContentKind" },
        "text": { "type": "string" }
      },
      "required": ["contentId", "kind", "text"],
      "additionalProperties": false
    },
    "ConversationContentKind": {
      "type": "string",
      "enum": ["text", "reasoning-summary", "command", "output", "activity-summary"]
    },
    "ConversationItem": {
      "type": "object",
      "properties": {
        "resource": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "turn": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "kind": { "$ref": "#/$defs/ConversationItemKind" },
        "status": { "$ref": "#/$defs/ConversationItemStatus" },
        "role": { "$ref": "#/$defs/ConversationItemRole" },
        "title": { "type": "string", "minLength": 1 },
        "contents": {
          "type": "array",
          "items": { "$ref": "#/$defs/ConversationContent" }
        },
        "relatedItem": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "approval": { "$ref": "#/$defs/ProviderApproval" }
      },
      "required": ["resource", "turn", "conversation", "kind", "status", "contents"],
      "additionalProperties": false
    },
    "ConversationItemKind": {
      "type": "string",
      "enum": ["message", "reasoning", "command", "file-change", "tool", "approval", "unknown"]
    },
    "ConversationItemRole": {
      "type": "string",
      "enum": ["user", "assistant"]
    },
    "ConversationItemStatus": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "interrupted",
        "declined",
        "approved",
        "denied",
        "expired",
        "unknown"
      ]
    },
    "ConversationListRequest": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/ProviderInstanceRoute" },
        "cursor": { "$ref": "../../core/v1/schema.json#/$defs/Cursor" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "required": ["route"],
      "additionalProperties": false
    },
    "ConversationListResponse": {
      "type": "object",
      "properties": {
        "conversations": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProviderConversation" }
        },
        "pageInfo": { "$ref": "../../core/v1/schema.json#/$defs/PageInfo" }
      },
      "required": ["conversations", "pageInfo"],
      "additionalProperties": false
    },
    "ConversationStatus": {
      "type": "string",
      "enum": ["idle", "running", "waiting-approval", "waiting-user-input", "error", "archived"]
    },
    "ConversationUpsertedEvent": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "#/$defs/ProviderConversation" }
      },
      "required": ["conversation"],
      "additionalProperties": false
    },
    "InstanceCapabilitiesRequest": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/ProviderInstanceRoute" }
      },
      "required": ["route"],
      "additionalProperties": false
    },
    "InstanceCapabilitiesResponse": {
      "type": "object",
      "properties": {
        "capabilities": { "$ref": "#/$defs/ProviderCapabilities" }
      },
      "required": ["capabilities"],
      "additionalProperties": false
    },
    "InstanceCreateRequest": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/ProviderInstanceRoute" },
        "instanceKind": { "$ref": "#/$defs/ProviderInstanceKind" },
        "displayName": { "type": "string", "minLength": 1 },
        "settings": { "$ref": "../../core/v1/schema.json#/$defs/JsonObject" }
      },
      "required": ["route", "instanceKind", "displayName", "settings"],
      "additionalProperties": false
    },
    "InstanceCreateResponse": {
      "type": "object",
      "properties": {
        "instance": { "$ref": "#/$defs/ProviderInstance" }
      },
      "required": ["instance"],
      "additionalProperties": false
    },
    "InstanceDestroyRequest": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/ProviderInstanceRoute" }
      },
      "required": ["route"],
      "additionalProperties": false
    },
    "InstanceDestroyResponse": {
      "type": "object",
      "properties": {
        "destroyed": { "type": "boolean" }
      },
      "required": ["destroyed"],
      "additionalProperties": false
    },
    "InstanceStartRequest": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/ProviderInstanceRoute" }
      },
      "required": ["route"],
      "additionalProperties": false
    },
    "InstanceStartResponse": {
      "type": "object",
      "properties": {
        "instance": { "$ref": "#/$defs/ProviderInstance" }
      },
      "required": ["instance"],
      "additionalProperties": false
    },
    "ProviderInstanceKind": {
      "type": "string",
      "minLength": 1
    },
    "InstanceStatus": {
      "type": "string",
      "enum": ["created", "starting", "ready", "stopping", "stopped", "error"]
    },
    "InstanceStatusChangedEvent": {
      "type": "object",
      "properties": {
        "instance": { "$ref": "#/$defs/ProviderInstance" },
        "previousStatus": { "$ref": "#/$defs/InstanceStatus" }
      },
      "required": ["instance"],
      "additionalProperties": false
    },
    "InstanceStopRequest": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/ProviderInstanceRoute" }
      },
      "required": ["route"],
      "additionalProperties": false
    },
    "InstanceStopResponse": {
      "type": "object",
      "properties": {
        "instance": { "$ref": "#/$defs/ProviderInstance" }
      },
      "required": ["instance"],
      "additionalProperties": false
    },
    "ProviderApproval": {
      "type": "object",
      "properties": {
        "resource": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "turn": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "kind": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "status": { "$ref": "#/$defs/ApprovalStatus" },
        "decisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/ApprovalDecision" },
          "minItems": 1,
          "uniqueItems": true
        },
        "requestedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "resolvedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "decision": { "$ref": "#/$defs/ApprovalDecision" },
        "extension": { "$ref": "#/$defs/ProviderExtension" }
      },
      "required": ["resource", "conversation", "turn", "kind", "title", "status", "decisions"],
      "additionalProperties": false
    },
    "ProviderCapability": {
      "type": "string",
      "enum": [
        "conversation.list",
        "conversation.get",
        "conversation.create",
        "turn.start",
        "turn.steer",
        "turn.interrupt",
        "approval.resolve"
      ]
    },
    "ProviderCapabilities": {
      "type": "object",
      "properties": {
        "methods": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProviderCapability" },
          "uniqueItems": true
        },
        "permissionLevels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "models": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "reasoningEfforts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "extensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProviderExtension" }
        }
      },
      "required": ["methods", "permissionLevels", "models", "reasoningEfforts", "extensions"],
      "additionalProperties": false
    },
    "ProviderConversation": {
      "type": "object",
      "properties": {
        "resource": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "title": { "type": "string", "minLength": 1 },
        "preview": { "type": "string" },
        "status": { "$ref": "#/$defs/ConversationStatus" },
        "permissionLevel": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "reasoningEffort": { "type": "string" },
        "workspaceRoot": { "type": "string", "minLength": 1 },
        "createdAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "updatedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "activeTurn": { "$ref": "#/$defs/ProviderTurn" },
        "extension": { "$ref": "#/$defs/ProviderExtension" }
      },
      "required": ["resource", "title", "status"],
      "additionalProperties": false
    },
    "ProviderDescribeRequest": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "ProviderDescribeResponse": {
      "type": "object",
      "properties": {
        "plugin": { "$ref": "#/$defs/ProviderPluginDescriptor" }
      },
      "required": ["plugin"],
      "additionalProperties": false
    },
    "ProviderExtension": {
      "type": "object",
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "data": { "$ref": "../../core/v1/schema.json#/$defs/JsonObject" }
      },
      "required": ["namespace", "data"],
      "additionalProperties": false
    },
    "ProviderInitializeRequest": {
      "type": "object",
      "properties": {
        "hostClientId": { "$ref": "../../core/v1/schema.json#/$defs/ClientId" },
        "hostDeviceId": { "$ref": "../../core/v1/schema.json#/$defs/DeviceId" },
        "hostVersion": { "type": "string", "minLength": 1 },
        "supportedVersions": { "$ref": "../../core/v1/schema.json#/$defs/VersionRange" }
      },
      "required": ["hostClientId", "hostDeviceId", "hostVersion", "supportedVersions"],
      "additionalProperties": false
    },
    "ProviderInitializeResponse": {
      "type": "object",
      "properties": {
        "selectedVersion": { "$ref": "../../core/v1/schema.json#/$defs/ProtocolVersion" },
        "plugin": { "$ref": "#/$defs/ProviderPluginDescriptor" }
      },
      "required": ["selectedVersion", "plugin"],
      "additionalProperties": false
    },
    "ProviderInstance": {
      "type": "object",
      "properties": {
        "route": { "$ref": "#/$defs/ProviderInstanceRoute" },
        "pluginId": { "$ref": "../../core/v1/schema.json#/$defs/ProviderPluginId" },
        "instanceKind": { "$ref": "#/$defs/ProviderInstanceKind" },
        "displayName": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/InstanceStatus" },
        "capabilities": { "$ref": "#/$defs/ProviderCapabilities" }
      },
      "required": ["route", "pluginId", "instanceKind", "displayName", "status", "capabilities"],
      "additionalProperties": false
    },
    "ProviderInstanceRoute": {
      "type": "object",
      "properties": {
        "deviceId": { "$ref": "../../core/v1/schema.json#/$defs/DeviceId" },
        "providerPluginId": { "$ref": "../../core/v1/schema.json#/$defs/ProviderPluginId" },
        "providerInstanceId": { "$ref": "../../core/v1/schema.json#/$defs/ProviderInstanceId" }
      },
      "required": ["deviceId", "providerPluginId", "providerInstanceId"],
      "additionalProperties": false
    },
    "ProviderPluginDescriptor": {
      "type": "object",
      "properties": {
        "pluginId": { "$ref": "../../core/v1/schema.json#/$defs/ProviderPluginId" },
        "displayName": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "supportedVersions": { "$ref": "../../core/v1/schema.json#/$defs/VersionRange" },
        "instanceKinds": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProviderInstanceKind" },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": ["pluginId", "displayName", "version", "supportedVersions", "instanceKinds"],
      "additionalProperties": false
    },
    "ProviderShutdownRequest": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "ProviderShutdownResponse": {
      "type": "object",
      "properties": {
        "accepted": { "type": "boolean" }
      },
      "required": ["accepted"],
      "additionalProperties": false
    },
    "ProviderTurn": {
      "type": "object",
      "properties": {
        "resource": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "status": { "$ref": "#/$defs/TurnStatus" },
        "displaySummary": { "type": "string" },
        "startedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "updatedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "completedAt": { "$ref": "../../core/v1/schema.json#/$defs/TimestampMs" },
        "extension": { "$ref": "#/$defs/ProviderExtension" }
      },
      "required": ["resource", "conversation", "status"],
      "additionalProperties": false
    },
    "TurnInterruptRequest": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "turn": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" }
      },
      "required": ["conversation", "turn"],
      "additionalProperties": false
    },
    "TurnInterruptResponse": {
      "type": "object",
      "properties": {
        "turn": { "$ref": "#/$defs/ProviderTurn" }
      },
      "required": ["turn"],
      "additionalProperties": false
    },
    "TurnOutputDeltaEvent": {
      "type": "object",
      "properties": {
        "turn": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "itemId": { "$ref": "../../core/v1/schema.json#/$defs/NativeResourceId" },
        "contentId": { "$ref": "../../core/v1/schema.json#/$defs/NativeResourceId" },
        "kind": { "$ref": "#/$defs/ConversationContentKind" },
        "delta": { "type": "string" },
        "extension": { "$ref": "#/$defs/ProviderExtension" }
      },
      "required": ["turn", "conversation", "itemId", "contentId", "kind", "delta"],
      "additionalProperties": false
    },
    "TurnStartRequest": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "clientMessageId": { "$ref": "../../core/v1/schema.json#/$defs/RequestId" },
        "message": { "type": "string", "minLength": 1 }
      },
      "required": ["conversation", "clientMessageId", "message"],
      "additionalProperties": false
    },
    "TurnStartResponse": {
      "type": "object",
      "properties": {
        "turn": { "$ref": "#/$defs/ProviderTurn" }
      },
      "required": ["turn"],
      "additionalProperties": false
    },
    "TurnStatus": {
      "type": "string",
      "enum": ["queued", "running", "waiting-approval", "completed", "failed", "interrupted"]
    },
    "TurnSteerRequest": {
      "type": "object",
      "properties": {
        "conversation": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "turn": { "$ref": "../../core/v1/schema.json#/$defs/RoutedResourceId" },
        "clientMessageId": { "$ref": "../../core/v1/schema.json#/$defs/RequestId" },
        "message": { "type": "string", "minLength": 1 }
      },
      "required": ["conversation", "turn", "clientMessageId", "message"],
      "additionalProperties": false
    },
    "TurnSteerResponse": {
      "type": "object",
      "properties": {
        "turn": { "$ref": "#/$defs/ProviderTurn" }
      },
      "required": ["turn"],
      "additionalProperties": false
    },
    "TurnUpsertedEvent": {
      "type": "object",
      "properties": {
        "turn": { "$ref": "#/$defs/ProviderTurn" }
      },
      "required": ["turn"],
      "additionalProperties": false
    }
  }
}
